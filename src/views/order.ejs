<%- include('partials/head', { title: order.reference }) %>
<%- include('partials/nav', { active: 'orders' }) %>
<main>
  <p><a href="<%= base %>/orders">← Orders</a></p>
  <% if (saved) { %><div class="notice">Order updated.</div><% } %>
  <div class="row" style="justify-content:space-between">
    <h1><%= order.reference %> <%- include('partials/pills', { o: order }) %></h1>
    <div class="row">
      <a class="btn secondary" href="tel:<%= order.phone %>">📞 Call</a>
      <a class="btn wa" href="<%= waUrl %>" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>

  <div class="card">
    <h2>Customer</h2>
    <dl class="kv">
      <dt>Name</dt><dd><%= order.customer_name %></dd>
      <dt>Phone</dt><dd><a href="tel:<%= order.phone %>"><%= order.phone %></a></dd>
      <dt>Email</dt><dd><%= order.email ? order.email : '—' %></dd>
      <dt>Address</dt><dd><%= order.address %></dd>
      <dt>State</dt><dd><%= order.state || '—' %></dd>
      <dt>Customer notes</dt><dd><%= order.customer_notes || '—' %></dd>
    </dl>
  </div>

  <div class="card">
    <h2>Items</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th>Line total</th></tr></thead>
      <tbody>
      <% items.forEach((i) => { %>
        <tr><td><%= i.product_name %> <span class="muted">(<%= i.product_code %>)</span></td><td><%= formatMoney(i.unit_price_minor, order.currency) %></td><td><%= i.quantity %></td><td><%= formatMoney(i.line_total_minor, order.currency) %></td></tr>
      <% }) %>
        <tr><td colspan="3"><strong>Order total</strong></td><td><strong><%= formatMoney(order.total_minor, order.currency) %></strong></td></tr>
      </tbody>
    </table></div>
    <p class="muted" style="font-size:13px;margin-bottom:0">Prices were taken from Skyfly's product list at the time of the order, not from the customer's browser.</p>
  </div>

  <div class="grid" style="grid-template-columns:repeat(auto-fit, minmax(260px, 1fr))">
    <form class="card" style="margin:0" method="post" action="<%= base %>/orders/<%= order.id %>/status">
      <%- include('partials/csrf') %>
      <input type="hidden" name="kind" value="fulfillment">
      <h2>Order status</h2>
      <select name="status" aria-label="Order status">
        <% statuses.forEach((s) => { %><option value="<%= s.value %>" <%= order.status === s.value ? 'selected' : '' %>><%= s.label %></option><% }) %>
      </select>
      <label>Note (optional, internal)</label>
      <textarea name="note" maxlength="1000" placeholder="e.g. Confirmed by phone, delivery Friday"></textarea>
      <p style="margin-bottom:0"><button type="submit">Save order status</button></p>
    </form>
    <form class="card" style="margin:0" method="post" action="<%= base %>/orders/<%= order.id %>/status">
      <%- include('partials/csrf') %>
      <input type="hidden" name="kind" value="payment">
      <h2>Payment status</h2>
      <select name="status" aria-label="Payment status">
        <% paymentStatuses.forEach((s) => { %><option value="<%= s.value %>" <%= order.payment_status === s.value ? 'selected' : '' %>><%= s.label %></option><% }) %>
      </select>
      <label>Note (optional, internal)</label>
      <textarea name="note" maxlength="1000" placeholder="e.g. Cash collected by rider"></textarea>
      <p class="muted" style="font-size:13px">Mark <strong>Paid</strong> only when the money has actually been received. This is what sends a Purchase event to your ad pixels.</p>
      <p style="margin-bottom:0"><button type="submit">Save payment status</button></p>
    </form>
  </div>
  <div style="height:16px"></div>

  <form class="card" method="post" action="<%= base %>/orders/<%= order.id %>/test">
    <%- include('partials/csrf') %>
    <% if (order.is_test) { %>
      <p style="margin-top:0"><strong>This is a test order.</strong> It is left out of sales figures and is never sent to ad platforms as a purchase.</p>
      <input type="hidden" name="is_test" value="false"><button class="secondary" type="submit">This is a real order</button>
    <% } else { %>
      <p class="muted" style="margin-top:0">Placed this order yourself to check a form? Mark it as a test so it doesn't count as a sale.</p>
      <input type="hidden" name="is_test" value="true"><button class="secondary" type="submit">Mark as test order</button>
    <% } %>
  </form>

  <div class="card" id="sheet">
    <h2>Google Sheet backup</h2>
    <% const sheetText = { synced: 'Copied to the Google Sheet', pending: 'Waiting to be copied', failed: 'Copy failed — will retry automatically', skipped: 'Not copied (no Google Sheet set for this business, or placed before automatic copying)' }; %>
    <% if (sheetNotice) { %><div class="notice">Retrying now. Refresh in a few seconds.</div><% } %>
    <p style="margin:0"><span class="pill <%= { synced: 'delivered', pending: 'pending', failed: 'cancelled', skipped: '' }[order.sheet_sync_status] %>"><%= sheetText[order.sheet_sync_status] %></span>
      <% if (order.sheet_synced_at) { %><span class="muted"> on <%= formatDate(order.sheet_synced_at) %></span><% } %>
      <% if (order.sheet_sync_status === 'failed') { %><br><span class="muted">Attempt <%= order.sheet_sync_attempts %>: <%= order.sheet_sync_error %>. Next try <%= formatDate(order.sheet_sync_next_at) %>.</span><% } %></p>
    <% if (['failed', 'skipped'].includes(order.sheet_sync_status)) { %>
      <form method="post" action="<%= base %>/orders/<%= order.id %>/sheet-retry" style="margin-top:8px"><%- include('partials/csrf') %><button class="secondary" type="submit"><%= order.sheet_sync_status === 'failed' ? 'Retry now' : 'Copy to the Google Sheet now' %></button></form>
    <% } %>
  </div>

  <div class="card">
    <h2>Source</h2>
    <dl class="kv">
      <dt>Placed</dt><dd><%= formatDate(order.created_at) %> (Lagos time)</dd>
      <% if (order.source !== 'manual') { %><dt>Submission ID</dt><dd><code><%= order.idempotency_key.slice(0, 8) %></code> <span class="muted">(matches the "ID" in Google Sheet rows)</span></dd><% } %>
      <dt>Entered via</dt><dd><%= { web: 'Website form', api: 'API', manual: 'Manual entry' }[order.source] %></dd>
      <dt>Landing page</dt><dd><%= order.landing_page_name || '—' %></dd>
      <dt>Page URL</dt><dd><%= order.source_url || '—' %></dd>
      <dt>Referrer</dt><dd><%= order.referrer || '—' %></dd>
      <dt>Campaign</dt><dd><%= [order.utm_source, order.utm_medium, order.utm_campaign, order.utm_content, order.utm_term].filter(Boolean).join(' / ') || '—' %></dd>
    </dl>
  </div>

  <% if (conversions.length) { %>
  <div class="card">
    <h2>Ad platform events</h2>
    <ul style="margin:0;padding-left:18px">
    <% conversions.forEach((c) => { %>
      <li><strong><%= c.event_name %></strong> to <%= c.provider === 'meta' ? 'Meta' : 'TikTok' %> (pixel <%= c.pixel_id %>):
        <% if (c.status === 'sent') { %><span class="pill delivered">sent</span> <span class="muted"><%= formatDate(c.sent_at) %></span>
        <% } else { %><span class="pill cancelled"><%= c.status %></span> <span class="muted"><%= c.last_error %></span>
          <form method="post" action="<%= base %>/orders/<%= order.id %>/conversions/<%= c.id %>/retry" style="display:inline"><%- include('partials/csrf') %><button class="secondary" type="submit">Retry</button></form>
        <% } %></li>
    <% }) %>
    </ul>
  </div>
  <% } %>

  <div class="card">
    <h2>History</h2>
    <ul style="margin:0;padding-left:18px">
      <% history.forEach((h) => { %>
        <li><span class="muted"><%= formatDate(h.created_at) %></span> —
          <% const L = h.kind === 'payment' ? PAYMENT_LABELS : STATUS_LABELS; %><%= h.kind === 'payment' ? 'Payment: ' : '' %><% if (h.from_status && h.from_status !== h.to_status) { %><%= L[h.from_status] %> → <% } %><strong><%= L[h.to_status] %></strong>
          <% if (h.user_name) { %><span class="muted">by <%= h.user_name %></span><% } %>
          <% if (h.note) { %><br><%= h.note %><% } %></li>
      <% }) %>
    </ul>
  </div>
</main>
</body></html>

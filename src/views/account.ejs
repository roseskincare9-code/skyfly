<%- include('partials/head', { title: 'Your account' }) %>
<%- include('partials/nav', { active: 'account' }) %>
<main class="narrow" data-account>
  <div class="page-head"><div><h1>Your account</h1><p><%= me.name %> · <%= me.email %></p></div></div>
  <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <div class="card">
    <dl class="kv">
      <dt>Member since</dt><dd><%= formatDate(me.created_at) %></dd>
      <dt>Terms accepted</dt><dd><%= me.terms_accepted_at ? `version ${me.terms_version}, ${formatDate(me.terms_accepted_at)}` : 'not recorded (account created before the terms checkbox)' %> · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></dd>
    </dl>
  </div>
  <form class="card" method="post" action="/account/password" data-change-password>
    <%- include('partials/csrf') %>
    <h2>Change password</h2>
    <label for="current_password">Current password</label><input id="current_password" name="current_password" type="password" required autocomplete="current-password">
    <label for="password">New password (at least 10 characters)</label><input id="password" name="password" type="password" minlength="10" required autocomplete="new-password">
    <label for="confirm">Confirm new password</label><input id="confirm" name="confirm" type="password" minlength="10" required autocomplete="new-password">
    <p class="muted" style="font-size:13px">Other devices are signed out. If Skyfly can send emails, you also get a confirmation email.</p>
    <button type="submit">Change password</button>
  </form>
  <form class="card" method="post" action="/account/requests" data-account-request>
    <%- include('partials/csrf') %>
    <h2>Your data</h2>
    <p class="muted" style="margin-top:0">Business owners can export orders and contacts at any time from their workspace. Here you can ask the Skyfly team for a copy of your personal data, or to delete your account. Deletion is handled by the team (some records must be kept for a time, see the Privacy Policy); nothing is deleted automatically.</p>
    <label for="kind">Request</label>
    <select id="kind" name="kind"><option value="export">A copy of my personal data</option><option value="deletion">Delete my account</option></select>
    <label for="note">Details (optional)</label><textarea id="note" name="note" maxlength="500"></textarea>
    <label for="req_password">Your password (to confirm)</label><input id="req_password" name="current_password" type="password" required autocomplete="current-password">
    <p><button class="secondary" type="submit">Send request</button></p>
    <% if (requests.length) { %><h3>Your requests</h3><% requests.forEach((r) => { %><p class="muted" style="margin:4px 0"><%= r.kind === 'deletion' ? 'Account deletion' : 'Data copy' %> · <%= formatDate(r.created_at) %> · <%= r.status %><%= r.response ? ` — ${r.response}` : '' %></p><% }) %><% } %>
  </form>
</main>
</body></html>

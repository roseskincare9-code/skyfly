<%- include('partials/head', { title: 'Log in' }) %>
<main class="narrow auth">
  <a class="auth-brand" href="/"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></a>
  <div class="card">
    <h1>Log in to Skyfly</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="post" action="/login">
      <%- include("partials/csrf") %>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Log in</button>
    </form>
    <% if (allowSignup) { %><p class="muted">No account yet? <a href="/signup">Create the owner account</a></p><% } %>
  </div>
</main>
</body></html>

<%- include('partials/head', { title: 'Business owner sign in' }) %>
<main class="narrow auth">
  <a class="auth-brand" href="/login"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></a>
  <div class="card" data-owner-login>
    <h1>Sign in to your business</h1>
    <p class="muted" style="margin-top:0">For business owners and their team.</p>
    <% if (typeof notice !== 'undefined' && notice) { %><p class="notice"><%= notice %></p><% } %>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/login">
      <%- include("partials/csrf") %>
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Sign In</button>
    </form>
    <p class="muted"><a href="/forgot-password">Forgot Password?</a></p>
    <% if (allowSignup) { %><p class="muted">New business? <a href="/signup">Create a business account</a></p><% } %>
  </div>
</main>
</body></html>

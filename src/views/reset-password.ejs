<%- include('partials/head', { title: 'Choose a new password' }) %>
<main class="narrow auth">
  <a class="auth-brand" href="/"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></a>
  <div class="card">
    <% if (!valid) { %>
      <h1>This link doesn't work any more</h1>
      <p>Reset links work once and expire. <a href="/forgot-password">Ask for a new link</a>.</p>
    <% } else { %>
      <h1>Choose a new password</h1>
      <p class="muted">For <%= email %>. You'll be signed out everywhere else.</p>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form method="post" action="/reset-password/<%= token %>">
        <%- include("partials/csrf") %>
        <label for="password">New password (at least 10 characters)</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
        <label for="confirm">Type it again</label>
        <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required>
        <button type="submit">Save new password</button>
      </form>
    <% } %>
  </div>
</main>
</body></html>

<%- include('partials/head', { title: 'Google Sheets' }) %>
<%- include('partials/nav', { active: 'sheet' }) %>
<main style="max-width:980px">
  <h1>Google Sheets</h1>
  <p class="muted">Connect your spreadsheets once, here. Every order from every landing page is saved in Skyfly first, then copied by the server to the business's <strong>default spreadsheet</strong>, or to a page's own spreadsheet if you choose one below. New landing pages use the default automatically. Failed copies are retried, and an order is never added to a sheet twice.</p>
  <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <% const statusPill = { ok: ['delivered', 'Connected'], needs_columns: ['cancelled', 'Needs column names'], error: ['cancelled', 'Not reachable'], unchecked: ['pending', 'Not checked yet'] }; %>
  <% const defaultConn = connections.find((c) => String(c.id) === String(defaultId)); %>
  <% const hasDirect = connections.some((c) => ['apps_script', 'google_api'].includes(c.provider)); %>

  <div class="card">
    <h2>Copy status</h2>
    <dl class="kv">
      <dt>Default spreadsheet</dt><dd><% if (defaultConn) { %><a href="#sheet-<%= defaultConn.id %>"><%= defaultConn.name %></a><% } else { %><strong>None</strong> <span class="muted">— orders are kept in Skyfly only until you connect one</span><% } %></dd>
      <dt>Last successful copy</dt><dd><%= lastSync ? formatDate(lastSync) : 'None yet' %></dd>
      <dt>Copied</dt><dd><a href="<%= base %>/orders?sheet=synced"><%= count.synced || 0 %></a></dd>
      <dt>Waiting</dt><dd><a href="<%= base %>/orders?sheet=pending"><%= count.pending || 0 %></a> <span class="muted">(new orders are copied about 3 minutes after they arrive)</span></dd>
      <dt>Failed</dt><dd><a href="<%= base %>/orders?sheet=failed"><strong><%= count.failed || 0 %></strong></a><% if (count.failed) { %> <span class="muted">— retried automatically</span><% } %></dd>
      <dt>Not copied</dt><dd><a href="<%= base %>/orders?sheet=skipped"><%= count.skipped || 0 %></a> <span class="muted">(placed before automatic copying, or no spreadsheet set)</span></dd>
    </dl>
    <div class="row" style="margin-top:12px">
      <% if (count.failed) { %><form method="post" action="<%= base %>/google-sheets/retry-failed"><%- include('partials/csrf') %><button type="submit">Retry all failed now</button></form><% } %>
      <a class="btn secondary" href="<%= base %>/orders/export.csv">Download all orders (CSV)</a>
      <a class="btn secondary" href="<%= base %>/google-sheets/export.csv">Download in sheet columns (CSV)</a>
    </div>
    <% if (!hasDirect) { %>
      <div class="warn-box" style="margin-top:12px" data-direct-cta><strong>Recommended:</strong> connect your spreadsheet directly: free, no SheetDB request limit, and every waiting order is sent once it is connected. Your existing tabs and history are not changed.
        <p style="margin:8px 0 0"><% if (googleEmail) { %><a class="btn" href="#add-google">Connect by sharing your sheet ↓</a> <% } %><a class="btn<%= googleEmail ? ' secondary' : '' %>" href="#add-script">Connect with Apps Script ↓</a></p></div>
    <% } %>
  </div>

  <% function googleForm() { %>
  <form class="card" method="post" action="<%= base %>/google-sheets/connections" id="add-google">
    <%- include('partials/csrf') %>
    <input type="hidden" name="kind" value="google_api">
    <h2>Connect by sharing your sheet (no Apps Script)</h2>
    <% if (googleEmail) { %>
      <p class="muted" style="margin-top:0">Skyfly writes through Google's Sheets API with its own Google service account. Nothing to install: you share the spreadsheet with Skyfly like you would with a person.</p>
      <ol style="padding-left:18px;font-size:14px">
        <li>Open your Google Sheet and click <strong>Share</strong>.</li>
        <li>Add <code data-google-email><%= googleEmail %></code> as <strong>Editor</strong> (untick “Notify people”), then click <strong>Share</strong>.</li>
        <li>Copy the sheet's link from your browser's address bar, paste it below, and click <strong>Connect</strong>.</li>
      </ol>
      <p class="muted">Skyfly writes only to its own tab (“<%= skyflyTab %>”, created automatically), never changes or deletes your other tabs, and checks every tab before adding an order so it is never added twice.</p>
      <label for="google-name">Name</label>
      <input id="google-name" name="name" maxlength="120" placeholder="e.g. Laroseorders" value="<%= form.kind === 'google_api' ? (form.name || '') : '' %>">
      <label for="google-link">Google Sheet link</label>
      <input id="google-link" name="spreadsheet_url" required placeholder="https://docs.google.com/spreadsheets/d/…/edit" value="<%= form.kind === 'google_api' ? (form.spreadsheet_url || '') : '' %>">
      <label for="google-tab">Tab Skyfly writes to (empty = a new tab named “<%= skyflyTab %>”)</label>
      <input id="google-tab" name="sheet_tab" maxlength="100" placeholder="<%= skyflyTab %>">
      <label style="color:var(--text)"><input type="checkbox" name="make_default" checked> Make it the default spreadsheet</label>
      <p><button type="submit">Connect</button></p>
    <% } else { %>
      <p class="muted" style="margin:0" data-google-missing><% if (googleProblem) { %>The server's Google service account setting cannot be used: <%= googleProblem %>. Paste the whole key file into <code>GOOGLE_SERVICE_ACCOUNT_JSON</code> again (see docs/GOOGLE_SHEETS.md).<% } else { %>Not available yet: Skyfly's Google service account has not been added to the server (setting <code>GOOGLE_SERVICE_ACCOUNT_JSON</code>; see docs/GOOGLE_SHEETS.md). Once it is, this box shows the email to share your sheet with.<% } %></p>
    <% } %>
  </form>
  <% } %>
  <% function directForm() { %>
  <form class="card" method="post" action="<%= base %>/google-sheets/connections" id="add-script">
    <%- include('partials/csrf') %>
    <input type="hidden" name="kind" value="apps_script"><input type="hidden" name="script_key" value="<%= scriptKey %>">
    <h2>Connect a spreadsheet directly (free, recommended)</h2>
    <p class="muted" style="margin-top:0">Orders go straight from Skyfly to your Google Sheet through a small script that lives in your own spreadsheet. No SheetDB account and no SheetDB request limit. Takes about 3 minutes:</p>
    <ol style="padding-left:18px;font-size:14px">
      <li>Open your Google Sheet → <strong>Extensions → Apps Script</strong>.</li>
      <li>Delete what is there, paste the script below, and click <strong>Save</strong>.</li>
      <li>Click <strong>Deploy → New deployment</strong> → type <strong>Web app</strong>. Execute as: <strong>Me</strong>. Who has access: <strong>Anyone</strong>. Click <strong>Deploy</strong> and allow access when Google asks.</li>
      <li>Copy the <strong>Web app URL</strong> (ends with <code>/exec</code>) into the box below and click Connect. Skyfly checks it at once, adds any missing columns to row 1 (existing rows are kept), and sends the orders that were waiting.</li>
    </ol>
    <label for="script-code">Script (contains this connection's private key: don't share it)</label>
    <textarea id="script-code" readonly rows="8" style="font-family:ui-monospace,monospace;font-size:12px"><%= appsScript %></textarea>
    <p style="margin:6px 0 0"><button type="button" class="secondary" data-copy="script-code">Copy script</button></p>
    <script src="/static/copy.js" defer></script>
    <label for="script-name">Name</label>
    <input id="script-name" name="name" maxlength="120" placeholder="e.g. Larose orders" value="<%= form.kind === 'apps_script' ? (form.name || '') : '' %>">
    <label for="script-url">Web app URL</label>
    <input id="script-url" name="api_url" required autocomplete="off" placeholder="https://script.google.com/macros/s/…/exec">
    <label for="script-tab">Tab Skyfly writes to (empty = a new tab named “<%= skyflyTab %>”; your existing tabs and their history are never changed)</label>
    <input id="script-tab" name="sheet_tab" maxlength="100" placeholder="<%= skyflyTab %>">
    <label for="script-link">Google Sheets link (optional, for “Open spreadsheet”)</label>
    <input id="script-link" name="spreadsheet_url" placeholder="https://docs.google.com/spreadsheets/d/…">
    <label style="color:var(--text)"><input type="checkbox" name="make_default" checked> Make it the default spreadsheet</label>
    <p><button type="submit">Connect</button></p>
  </form>
  <% } %>
  <% if (!hasDirect) { googleForm(); directForm(); } %>

  <h2 style="margin-top:28px">Connected spreadsheets</h2>
  <% if (!connections.length) { %><div class="card empty"><p>No spreadsheet connected yet. Add one below.</p></div><% } %>
  <% connections.forEach((c) => { const isDefault = String(c.id) === String(defaultId); const [pillClass, pillText] = statusPill[c.check_status]; %>
  <div class="card" id="sheet-<%= c.id %>">
    <div class="row" style="justify-content:space-between">
      <h2 style="margin:0"><%= c.name %> <% if (isDefault) { %><span class="pill confirmed">Default</span><% } %> <span class="pill <%= pillClass %>"><%= pillText %></span></h2>
      <div class="row">
        <% if (c.spreadsheet_url) { %><a class="btn secondary" href="<%= c.spreadsheet_url %>" target="_blank" rel="noopener noreferrer">Open spreadsheet ↗</a><% } %>
        <a class="btn secondary" href="<%= base %>/google-sheets/export.csv?connection=<%= c.id %>">Download its rows (CSV)</a>
      </div>
    </div>
    <dl class="kv" style="margin-top:10px">
      <dt><%= { apps_script: 'Google Apps Script', google_api: 'Google Sheets API (shared with Skyfly)', sheetdb: 'SheetDB API' }[c.provider] %></dt><dd><code>…<%= c.api_hint %></code> <span class="muted"><%= encrypted ? '(stored encrypted)' : '' %></span></dd>
      <dt>Tab</dt><dd><%= c.sheet_tab || 'First tab' %></dd>
      <dt>Columns</dt><dd><%= c.check_detail || 'Not checked yet.' %><% if (c.checked_at) { %> <span class="muted">Checked <%= formatDate(c.checked_at) %>.</span><% } %></dd>
      <dt>Last successful copy</dt><dd><%= c.last_success_at ? formatDate(c.last_success_at) : 'None yet' %></dd>
      <% if (c.last_error && (!c.last_success_at || c.last_error_at > c.last_success_at)) { %><dt>Last error</dt><dd class="error" style="margin:0"><%= c.last_error %> <span class="muted">(<%= formatDate(c.last_error_at) %>)</span></dd><% } %>
      <% if (c.provider === 'sheetdb' && /429|limit/i.test(c.last_error || '')) { %><dt>What to do</dt><dd>SheetDB's request limit is used up. <a href="#<%= googleEmail ? 'add-google' : 'add-script' %>">Connect the same spreadsheet directly instead (free)</a>; this connection and its orders are kept.</dd><% } %>
      <dt>Orders</dt><dd><%= c.synced %> copied<% if (c.failed) { %>, <a href="<%= base %>/orders?sheet=failed"><strong><%= c.failed %> failed</strong></a><% } %></dd>
    </dl>
    <% if (c.check_status === 'needs_columns') { %>
      <div class="warn-box" style="margin-top:12px">
        <p style="margin-top:0"><strong>The sheet needs Skyfly's column names in row 1.</strong> Open the spreadsheet and type these 12 names into row 1, one per cell from A1 to L1:</p>
        <p><code><%= columns.join('  ') %></code></p>
        <p class="muted">Then click "Check connection": every waiting order is sent at once, with no duplicates. (Skyfly also checks by itself every 6 hours.)</p>
        <form method="post" action="<%= base %>/google-sheets/connections/<%= c.id %>/setup"><%- include('partials/csrf') %><button class="secondary" type="submit">Or let Skyfly add a “<%= skyflyTab %>” tab</button> <span class="muted">(paid SheetDB plans only; your other tabs are not changed)</span></form>
      </div>
    <% } %>
    <div class="row" style="margin-top:12px">
      <form method="post" action="<%= base %>/google-sheets/connections/<%= c.id %>/check"><%- include('partials/csrf') %><button class="secondary" type="submit">Check connection</button></form>
      <% if (!isDefault) { %><form method="post" action="<%= base %>/google-sheets/connections/<%= c.id %>/default"><%- include('partials/csrf') %><button class="secondary" type="submit">Make default</button></form><% } %>
      <% if (c.failed) { %><form method="post" action="<%= base %>/google-sheets/retry-failed"><%- include('partials/csrf') %><input type="hidden" name="connection_id" value="<%= c.id %>"><button class="secondary" type="submit">Retry its failed copies</button></form><% } %>
    </div>
    <details style="margin-top:12px">
      <summary>Edit or remove</summary>
      <form method="post" action="<%= base %>/google-sheets/connections/<%= c.id %>">
        <%- include('partials/csrf') %>
        <label for="name-<%= c.id %>">Name</label>
        <input id="name-<%= c.id %>" name="name" value="<%= c.name %>" maxlength="120">
        <label for="tab-<%= c.id %>">Tab name (empty = first tab)</label>
        <input id="tab-<%= c.id %>" name="sheet_tab" value="<%= c.sheet_tab || '' %>" maxlength="100">
        <label for="link-<%= c.id %>">Google Sheets link (for “Open spreadsheet”)</label>
        <input id="link-<%= c.id %>" name="spreadsheet_url" value="<%= c.spreadsheet_url || '' %>" placeholder="https://docs.google.com/spreadsheets/d/…">
        <label for="url-<%= c.id %>">New SheetDB API URL (leave empty to keep the saved one)</label>
        <input id="url-<%= c.id %>" name="api_url" value="" autocomplete="off" placeholder="https://sheetdb.io/api/v1/…">
        <p><button type="submit">Save</button></p>
      </form>
      <form method="post" action="<%= base %>/google-sheets/connections/<%= c.id %>/delete"><%- include('partials/csrf') %><button class="secondary" type="submit">Remove this connection</button> <span class="muted">Pages using it switch to the default. The spreadsheet itself is not changed.</span></form>
    </details>
  </div>
  <% }) %>

  <div class="card" id="pages">
    <h2>Landing pages</h2>
    <p class="muted" style="margin-top:0">Each page uses the default spreadsheet unless you pick its own here (for separate reporting). Newly imported pages use the default automatically.</p>
    <% if (!pages.length) { %><p>No landing pages yet.</p><% } else { %>
    <div class="table-wrap"><table class="stack"><thead><tr><th>Page</th><th>Spreadsheet</th></tr></thead><tbody>
    <% pages.forEach((p) => { %>
      <tr><td><a href="<%= base %>/landing-pages/<%= p.id %>"><%= p.name %></a> <span class="muted"><code><%= p.slug %></code></span></td>
        <td><form method="post" action="<%= base %>/google-sheets/pages/<%= p.id %>" class="row">
          <%- include('partials/csrf') %>
          <select name="sheet_connection_id" aria-label="Spreadsheet for <%= p.name %>">
            <option value="">Default<%= defaultConn ? ` (${defaultConn.name})` : ' (none set)' %></option>
            <% connections.forEach((c) => { %><option value="<%= c.id %>" <%= String(p.sheet_connection_id) === String(c.id) ? 'selected' : '' %>>Own sheet: <%= c.name %></option><% }) %>
          </select>
          <button class="secondary" type="submit">Save</button>
        </form></td></tr>
    <% }) %>
    </tbody></table></div><% } %>
  </div>

  <% if (hasDirect) { googleForm(); directForm(); } %>

  <form class="card" method="post" action="<%= base %>/google-sheets/connections" id="add">
    <%- include('partials/csrf') %>
    <h2>Connect a spreadsheet through SheetDB</h2>
    <p class="muted" style="margin-top:0">Free SheetDB plans have a small monthly request limit; when it is used up, copies wait (orders stay safe in Skyfly).</p>
    <p class="muted" style="margin-top:0">Use the SheetDB API URL of the Google Sheet (in SheetDB: your API → “API URL”). It is stored encrypted and never shown again; anyone with it can add rows, so keep it private.</p>
    <label for="new-name">Name</label>
    <input id="new-name" name="name" maxlength="120" placeholder="e.g. Larose orders" value="<%= form.name || '' %>">
    <label for="new-url">SheetDB API URL</label>
    <input id="new-url" name="api_url" required autocomplete="off" placeholder="https://sheetdb.io/api/v1/…">
    <label for="new-tab">Tab name (optional, empty = first tab)</label>
    <input id="new-tab" name="sheet_tab" maxlength="100" value="<%= form.sheet_tab || '' %>">
    <label for="new-link">Google Sheets link (optional, for “Open spreadsheet”)</label>
    <input id="new-link" name="spreadsheet_url" placeholder="https://docs.google.com/spreadsheets/d/…" value="<%= form.spreadsheet_url || '' %>">
    <label style="color:var(--text)"><input type="checkbox" name="make_default" <%= connections.length ? '' : 'checked' %>> Make it the default spreadsheet</label>
    <p><button type="submit">Connect</button></p>
  </form>

  <div class="card" id="recover">
    <h2>Orders only in the Google Sheet</h2>
    <p class="muted" style="margin-top:0">When a landing page can't reach Skyfly, the order still goes to the Google Sheet, marked <code>NOT IN SKYFLY</code> (or <code>SKYFLY NOT CONNECTED</code> before Skyfly was connected). Add them here so nothing is missed. Each row can be added once.</p>
    <% if (!defaultConn && !connections.length) { %><p>Connect a spreadsheet first.</p>
    <% } else if (!checked) { %><a class="btn secondary" href="<%= base %>/google-sheets?check=1#recover">Check the Google Sheet now</a>
    <% } else if (fetchError) { %><p class="error">Could not read the Google Sheet: <%= fetchError %></p>
    <% } else if (!rows.length) { %><p>No orders are waiting: every order is in Skyfly.</p>
    <% } else { %>
      <div class="table-wrap"><table class="stack"><thead><tr><th>Placed</th><th>Customer</th><th>Package</th><th>Marked</th><th></th></tr></thead><tbody>
      <% rows.forEach(({ row, recovered, prefill }) => { %>
        <tr><td class="muted"><%= row.timestamp %></td><td><%= row.fullName %><br><span class="muted"><%= row.phone %></span></td><td><%= row.package %></td>
          <td class="muted"><%= String(row.source || '').split('|').slice(1).join('|').trim() %></td>
          <td><% if (recovered) { %><span class="pill delivered">In Skyfly</span> <% if (recovered.id) { %><a href="<%= base %>/orders/<%= recovered.id %>"><%= recovered.reference %></a><% } %>
              <% } else { %><a class="btn secondary" href="<%= base %>/orders/new?<%= prefill %>">Review and add</a><% } %></td></tr>
      <% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</main>
</body></html>

<%- include('partials/head', { title: 'Landing pages' }) %>
<%- include('partials/nav', { active: 'pages' }) %>
<main>
  <div class="row" style="justify-content:space-between">
    <h1>Landing pages</h1>
    <a class="btn secondary" href="<%= base %>/landing-pages/new">Connect landing page</a>
  </div>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (typeof allowance !== 'undefined' && allowance) { %><p class="muted" data-page-allowance><%= allowance.used %> of <%= allowance.limit %> landing pages used<%= allowance.used >= allowance.limit ? ' (limit reached: archive a page, or ask the Skyfly team for more)' : '' %>. Archived pages don't count.</p><% } %>
  <details class="card" data-import-methods>
    <summary><strong>Ways to add a landing page</strong></summary>
    <ul style="margin:8px 0 0">
      <li><strong>Create a page</strong> from Skyfly's template, then edit it in the builder.</li>
      <li><strong>Import a file</strong>: a <code>.zip</code> (index.html with its CSS, JavaScript, images and fonts) or a single <code>.html</code>, up to 25 MB. Everything is hosted by Skyfly.</li>
      <li><strong>Import from a web address</strong>: any public <code>https://</code> page. Its images and styles keep loading from the original site.</li>
      <li><strong>Connect a page hosted elsewhere</strong> ("Connect landing page"): it keeps its own address and sends orders to Skyfly.</li>
    </ul>
    <p class="muted" style="margin:8px 0 0">Not supported directly: pages behind a sign-in, and shop builders' checkout pages (Shopify, Wix, Webflow…). Export or save the page as HTML and import the file, or import its public address. If an import fails, Skyfly shows the reason and what to do instead. Every page gets its own permanent address when published, and uses this business's products, checkout, tracking and order destination.</p>
  </details>

  <form class="card" method="post" action="<%= base %>/landing-pages/template">
    <%- include('partials/csrf') %>
    <h2>Create a page</h2>
    <p class="muted" style="margin-top:0">Start from Skyfly's page template: hero, benefits, photos, questions and the Skyfly checkout with your products. Edit the text, images and colours, preview on phone and desktop, then publish.</p>
    <label for="tpl-name">Page name</label>
    <input id="tpl-name" name="name" maxlength="200" placeholder="e.g. October promo">
    <p style="margin-bottom:0"><button type="submit">Create page</button></p>
  </form>

  <form class="card" method="post" action="<%= base %>/landing-pages/upload" enctype="multipart/form-data">
    <%- include('partials/csrf') %>
    <h2>Import a landing page</h2>
    <p class="muted" style="margin-top:0">Upload a page made anywhere (ChatGPT, Claude, another tool or a developer): a <strong>.zip</strong> with index.html and its CSS, JavaScript, images and fonts, or a single <strong>.html</strong> file. Skyfly keeps its design, connects its order form and buttons to Skyfly's checkout (WhatsApp stays only as a support button), and checks it before publishing.</p>
    <label for="imp-name">Page name</label>
    <input id="imp-name" name="name" maxlength="200" placeholder="e.g. October promo">
    <label for="imp-file">File (.zip or .html, max 25 MB)</label>
    <div class="dropzone" data-dropzone style="border:2px dashed var(--line);border-radius:12px;padding:18px;text-align:center">
      <p style="margin:0 0 8px">Drag and drop the file here, or choose it:</p>
      <input id="imp-file" name="file" type="file" accept=".zip,.html,.htm" required>
      <p class="muted" data-dropzone-name style="margin:8px 0 0"></p>
    </div>
    <progress data-upload-progress max="100" value="0" hidden style="width:100%;margin-top:10px"></progress>
    <p class="muted" data-upload-status role="status" style="margin:4px 0 0"></p>
    <p style="margin-bottom:0"><button type="submit">Upload</button></p>
  </form>

  <form class="card" method="post" action="<%= base %>/landing-pages/import-url">
    <%- include('partials/csrf') %>
    <h2>Import from a web address</h2>
    <p class="muted" style="margin-top:0">For a page that is already online. Skyfly copies the page itself; its images, styles and fonts keep loading from the original site, so leave that site up (or upload a .zip instead to host everything on Skyfly). Only public <strong>https://</strong> addresses can be imported.</p>
    <label for="url-name">Page name</label>
    <input id="url-name" name="name" maxlength="200" placeholder="e.g. October promo">
    <label for="url-addr">Page address</label>
    <input id="url-addr" name="page_url" type="url" required placeholder="https://example.com/my-page/" inputmode="url">
    <p style="margin-bottom:0"><button type="submit">Import</button></p>
  </form>

  <p class="muted">Pages hosted by Skyfly, or hosted elsewhere (e.g. GitHub Pages), can send orders to Skyfly. Each page has a <strong>form key</strong> so orders are attributed to it. Only <strong>published/active</strong> pages take orders, and only for their connected products.</p>

  <% pages.forEach((p) => { %>
  <div class="card">
    <div class="row" style="justify-content:space-between">
      <h2 style="margin:0"><%= p.name %> <span class="pill <%= p.status %>"><%= p.published_version_id ? (p.status === 'active' ? 'published' : 'unpublished') : p.status %></span></h2>
      <a href="<%= base %>/orders?page=<%= p.id %>"><%= p.order_count %> orders →</a>
    </div>
    <dl class="kv" style="margin-top:10px">
      <dt>Public address</dt><dd>
        <% if (p.public_url) { %>
          <input id="pub-url-<%= p.id %>" readonly value="<%= p.public_url %>" style="max-width:420px" aria-label="Public address for ads">
          <button type="button" class="secondary" data-copy="pub-url-<%= p.id %>">Copy link</button>
          <a href="<%= p.public_url %>" target="_blank" rel="noopener">Open ↗</a>
        <% } else if (p.published_version_id) { %>Not public: this page is unpublished. Publish it under Manage to give it an address.
        <% } else if (p.url) { %>Not hosted by Skyfly (it runs at its external URL below)
        <% } else { %>Not public yet: publish it under Manage to get its address<% } %>
      </dd>
      <dt>External URL</dt><dd><% if (p.url) { %><a href="<%= p.url %>" target="_blank" rel="noopener"><%= p.url %></a><% } else { %>—<% } %></dd>
      <dt>Form key</dt><dd><code><%= p.slug %></code></dd>
      <dt>Products</dt><dd><%= p.product_names || 'None connected' %></dd>
      <dt>Google Sheet</dt><dd><a href="<%= base %>/google-sheets#pages"><%= p.sheet_name ? p.sheet_name + (p.sheet_connection_id ? ' (own sheet)' : ' (default)') : 'None set' %></a></dd>
      <dt>Orders</dt><dd><%- include('partials/connection', { p, detected: p.code_detected }) %></dd>
    </dl>
    <div class="row" style="margin-top:12px">
      <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>">Manage</a>
      <% if (p.url) { %>
        <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>/preview">Preview</a>
        <a class="btn secondary" href="<%= p.url %>" target="_blank" rel="noopener">Open page ↗</a>
      <% } %>
      <form method="post" action="<%= base %>/landing-pages/<%= p.id %>/duplicate"><%- include('partials/csrf') %><button class="secondary" type="submit">Duplicate</button></form>
      <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>/export.json">Export</a>
    </div>
  </div>
  <% }) %>

  <form class="card" method="post" action="<%= base %>/landing-pages/import">
    <%- include('partials/csrf') %>
    <h2>Import</h2>
    <p class="muted" style="margin-top:0">Paste a Skyfly landing page export. This imports the page's Skyfly settings (name, URL, connected products). It does not import the page's HTML or design, which stay on its own host.</p>
    <textarea name="json" required placeholder='{"format":"skyfly.landing-page.v1", ...}'></textarea>
    <p><button type="submit" class="secondary">Import as draft</button></p>
  </form>
</main>
<script src="/static/copy.js" defer></script>
<script src="/static/upload.js" defer></script>
</body></html>

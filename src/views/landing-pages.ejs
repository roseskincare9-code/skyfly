<%- include('partials/head', { title: 'Landing pages' }) %>
<%- include('partials/nav', { active: 'pages' }) %>
<main>
  <div class="row" style="justify-content:space-between">
    <h1>Landing pages</h1>
    <a class="btn secondary" href="<%= base %>/landing-pages/new">Register an external page</a>
  </div>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form class="card" method="post" action="<%= base %>/landing-pages/upload" enctype="multipart/form-data">
    <%- include('partials/csrf') %>
    <h2>Import a landing page</h2>
    <p class="muted" style="margin-top:0">Upload a <strong>.zip</strong> with your page (index.html) and its CSS, JavaScript, images and fonts, or a single <strong>.html</strong> file. Skyfly hosts it exactly as it is and tells you what to check before publishing.</p>
    <label for="imp-name">Page name</label>
    <input id="imp-name" name="name" maxlength="200" placeholder="e.g. Larose October promo">
    <label for="imp-file">File (.zip or .html, max 25 MB)</label>
    <input id="imp-file" name="file" type="file" accept=".zip,.html,.htm" required>
    <p style="margin-bottom:0"><button type="submit">Upload</button></p>
  </form>

  <p class="muted">Pages hosted by Skyfly, or hosted elsewhere (e.g. GitHub Pages), can send orders to Skyfly. Each page has a <strong>form key</strong> so orders are attributed to it. Only <strong>published/active</strong> pages take orders, and only for their connected products.</p>

  <% pages.forEach((p) => { %>
  <div class="card">
    <div class="row" style="justify-content:space-between">
      <h2 style="margin:0"><%= p.name %> <span class="pill <%= p.status %>"><%= p.published_version_id ? (p.status === 'active' ? 'published' : 'unpublished') : p.status %></span></h2>
      <a href="<%= base %>/orders?page=<%= p.id %>"><%= p.order_count %> orders →</a>
    </div>
    <dl class="kv" style="margin-top:10px">
      <% if (p.published_version_id) { %><dt>Hosted by Skyfly</dt><dd><%= p.custom_domain ? 'https://' + p.custom_domain + '/' : 'yes' %></dd><% } %>
      <dt>External URL</dt><dd><% if (p.url) { %><a href="<%= p.url %>" target="_blank" rel="noopener"><%= p.url %></a><% } else { %>—<% } %></dd>
      <dt>Form key</dt><dd><code><%= p.slug %></code></dd>
      <dt>Products</dt><dd><%= p.product_names || 'None connected' %></dd>
      <dt>Orders</dt><dd><%- include('partials/connection', { p, detected: p.code_detected }) %></dd>
    </dl>
    <div class="row" style="margin-top:12px">
      <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>">Manage</a>
      <% if (p.url) { %>
        <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>/preview">Preview</a>
        <a class="btn secondary" href="<%= p.url %>" target="_blank" rel="noopener">Open page ↗</a>
      <% } %>
      <form method="post" action="<%= base %>/landing-pages/<%= p.id %>/duplicate"><%- include('partials/csrf') %><button class="secondary" type="submit">Duplicate</button></form>
      <a class="btn secondary" href="<%= base %>/landing-pages/<%= p.id %>/export.json">Export</a>
    </div>
  </div>
  <% }) %>

  <form class="card" method="post" action="<%= base %>/landing-pages/import">
    <%- include('partials/csrf') %>
    <h2>Import</h2>
    <p class="muted" style="margin-top:0">Paste a Skyfly landing page export. This imports the page's Skyfly settings (name, URL, connected products). It does not import the page's HTML or design, which stay on its own host.</p>
    <textarea name="json" required placeholder='{"format":"skyfly.landing-page.v1", ...}'></textarea>
    <p><button type="submit" class="secondary">Import as draft</button></p>
  </form>
</main>
</body></html>

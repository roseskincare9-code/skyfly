<%- include('partials/head', { title: 'AI Media Buyer' }) %>
<%- include('partials/nav') %>
<%
  const TAB_LABELS = { overview: 'AI Media Buyer', analysis: 'Performance Analysis', whatsapp: 'WhatsApp Conversion Audit', campaigns: 'Campaigns', creatives: 'Creative Library', recommendations: 'AI Recommendations', briefs: 'Video Briefs', approvals: 'Approvals', reports: 'Reports', settings: 'Advertising Settings' };
  const NOTICES = { profile: 'Business profile saved.', connected: 'Meta ad account connected and verified with Meta.', disconnected: 'Ad account disconnected; its token was deleted. Nothing was changed in Meta.', selected: 'Ad account switched.', uploaded: 'Added to the creative library.', reviewed: 'Cloudy reviewed the creative.', deleted: 'Creative deleted.', monitoring: 'Monitoring settings saved.', dismissed: 'Alert dismissed.', leads: 'WhatsApp lead log imported.', onboarding: 'Saved.', onboarded: 'Your profile is complete. Skyfly is now analysing the business and preparing a campaign plan.', auto: 'Skyfly started the analysis and campaign plan.', health: 'Connection re-checked with Meta.', fb_cancelled: 'Facebook Login was cancelled; nothing was connected.', fb_pick: 'Signed in with Facebook. Choose which ad accounts to connect to this business.' };
  const cur = connection?.currency || business.currency;
  const money = (v) => v == null ? '—' : `${cur} ${Number(v).toLocaleString('en-NG', { maximumFractionDigits: 2 })}`;
  const num = (v, d = 2) => v == null ? '—' : Number(v).toLocaleString('en-NG', { maximumFractionDigits: d });
  const byKind = (k) => items.filter((i) => i.kind === k);
  const pending = items.filter((i) => i.status === 'proposed');
  const PERIODS = { today: 'Today', yesterday: 'Yesterday', last_7d: 'Last 7 days', last_30d: 'Last 30 days' };
  const statusPill = (s) => ({ proposed: 'pending', approved: 'confirmed', executed: 'delivered', rejected: 'cancelled', failed: 'cancelled', info: 'processing' }[s] || 'pending');
  const analyzeLink = (secondary = false) => `<a class="btn${secondary ? ' secondary' : ''}" href="${mbBase}?tab=analysis" data-analyze-link>Analyze my campaigns</a>`;
  // Performance tasks belong to ChatGPT when it is on: Cloudy's buttons for them give way to "Analyze my campaigns".
  const genBtn = (task, label, secondary = true) => !cloudyHandles(task) ? '' : `<form method="post" action="${mbBase}/generate/${task}" style="display:inline"><input type="hidden" name="_csrf" value="${csrfToken}"><button class="btn${secondary ? ' secondary' : ''}" type="submit" ${aiOn || (task === 'campaign_draft' && aiEngine) ? '' : 'disabled title="Cloudy is not switched on yet"'} data-generate="${task}">${label}</button></form>`;
%>
<main data-media-buyer>
  <div class="page-head"><div><h1>AI Media Buyer</h1><p>Skyfly's AI media buyer works only with <%= business.name %>'s own profile, Meta ad account and creatives. Nothing goes live or spends money without your explicit approval.</p></div></div>
  <% if (notice && NOTICES[notice]) { %><div class="notice" role="status"><%= NOTICES[notice] %></div><% } %>
  <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
  <p class="muted" style="font-size:13px" data-ai-engines>Analysis engines (Performance Analysis, WhatsApp audit) · <strong>ChatGPT</strong>: <span data-analyst-status><%= engineOn.chatgpt ? 'on' : 'off (OPENAI_API_KEY)' %></span> · <strong>Claude</strong>: <span data-claude-status><%= engineOn.claude ? 'on' : 'off (ANTHROPIC_API_KEY)' %></span> · <strong>Cloudy</strong> assistant (Ask, creative briefs, campaign drafts, creative review): <span data-cloudy-status><%= aiOn ? `on (${aiProvider === 'claude' ? 'Claude' : 'ChatGPT'})` : 'off (OPENAI_API_KEY or ANTHROPIC_API_KEY)' %></span></p>
  <% if (!aiOn) { %><div class="warn-box" data-ai-off>Cloudy's AI answers are not switched on yet: the Skyfly server has no AI key (OPENAI_API_KEY for ChatGPT, or ANTHROPIC_API_KEY for Claude). This is set once by the Skyfly team on the server, not connected by each business. Your profile, Meta connection, live numbers and creative library work now.</div><% } %>
  <% if (!analystOn) { %><div class="warn-box" data-analyst-off>ChatGPT analysis is not switched on yet (the server has no OPENAI_API_KEY).<%= engineOn.claude ? ' Claude can analyse on its own.' : ' The Performance Analysis tab still shows Skyfly\'s own rule-based checks.' %></div><% } %>

  <% if (accounts.length) { %>
  <form method="post" action="<%= mbBase %>/accounts/select" class="row" data-account-switcher style="gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap">
    <%- include('partials/csrf') %><input type="hidden" name="tab" value="<%= tab %>">
    <label for="account" style="margin:0">Ad account</label>
    <select id="account" name="account" style="max-width:320px">
      <% accounts.forEach((a) => { %><option value="<%= a.ad_account_id %>" <%= a.selected ? 'selected' : '' %>><%= a.ad_account_name || 'Ad account' %> · act_<%= a.ad_account_id %></option><% }) %>
    </select>
    <button class="btn secondary" type="submit" data-switch>Switch</button>
  </form>
  <% } %>
  <nav class="row" role="tablist" style="gap:8px;margin-bottom:14px;flex-wrap:wrap">
    <% Object.entries(TAB_LABELS).forEach(([k, l]) => { %><a role="tab" class="btn <%= k === tab ? '' : 'secondary' %>" aria-selected="<%= k === tab %>" href="<%= mbBase %>?tab=<%= k %>" data-tab="<%= k %>"><%= l %><%= k === 'approvals' && pending.length ? ` (${pending.length})` : '' %></a><% }) %>
  </nav>

  <% if (tab === 'overview') { const O = onb; const st = O.onboarding; const steps = [
      ['Business profile', O.complete, O.complete ? 'complete' : `missing: ${O.missing.map((k) => onboardingFields[k]).join(', ')}`],
      ['Meta ad account', Boolean(O.connected), O.connected ? `act_${O.connected.ad_account_id}${O.connected.health?.problems?.length ? ` · ${O.connected.health.problems.length} issue(s), see Advertising Settings` : ''}` : 'not connected (Advertising Settings)'],
      ['Business analysis', Boolean(st.analysis_id), st.analysis_id ? 'ready' : '—'],
      ['Campaign plan', Boolean(st.plan_item_id), st.plan_item_id ? 'ready for your review' : '—'],
      ['Built in Meta (PAUSED)', builds.some((b) => ['built', 'launched'].includes(b.status)), builds[0] ? builds[0].status : '—'],
      ['Launched', builds.some((b) => b.status === 'launched'), builds.some((b) => b.status === 'launched') ? 'yes' : 'only after your authorisation'],
    ]; %>
    <div class="card" data-getting-started id="onboarding"><h2>Getting started</h2>
      <ol class="checklist" style="padding-left:18px"><% steps.forEach(([l, ok, d]) => { %><li data-step-ok="<%= ok %>"><%= ok ? '✅' : '⬜' %> <strong><%= l %></strong> <span class="muted">· <%= d %></span></li><% }) %></ol>
      <% const waitingFor = [...(O.complete ? [] : [`the business profile (${O.missing.length} item${O.missing.length === 1 ? '' : 's'} missing)`]), ...(O.connected ? [] : ['a connected Meta ad account']), ...(aiEngine ? [] : ['an AI key on the Skyfly server (OPENAI_API_KEY or ANTHROPIC_API_KEY): the Skyfly team adds it'])]; %>
      <p data-auto-status>Automatic analysis and plan: <strong><%= st.auto_status === 'idle' && waitingFor.length ? 'waiting' : st.auto_status %></strong><%= st.auto_detail ? ` · ${st.auto_detail}` : '' %><% if (st.auto_status === 'idle' && waitingFor.length) { %><span data-waiting-for> · starts automatically once it has <%= waitingFor.join(', ') %>.</span><% } %>
        <% if (st.plan_item_id) { %> · <a href="<%= mbBase %>/items/<%= st.plan_item_id %>">open the plan</a><% } %><% if (st.analysis_id) { %> · <a href="<%= mbBase %>/analysis/<%= st.analysis_id %>">open the analysis</a><% } %></p>
      <% if (O.complete && st.auto_status !== 'running') { %><form method="post" action="<%= mbBase %>/onboarding/run" style="display:inline"><%- include('partials/csrf') %><button class="btn secondary" type="submit" data-run-auto <%= aiEngine && O.connected ? '' : 'disabled' %>>Run analysis and plan now</button></form><% } %>
      <div data-onboarding-chat style="margin-top:12px">
        <div style="max-height:380px;overflow:auto">
          <% if (!onbMessages.length) { %><div class="card" style="margin:6px 0"><strong>Skyfly media buyer:</strong> Hi! I'll set up your advertising in a few messages. Tell me about your business: what you sell, at what price, where your customers are, and your daily ad budget.<%= O.missing.length ? '' : ' Your profile is already complete.' %></div><% } %>
          <% onbMessages.forEach((m) => { %><div style="margin:8px 0;<%= m.role === 'user' ? 'text-align:right' : '' %>"><div class="<%= m.role === 'user' ? 'pill' : 'card' %>" style="white-space:pre-wrap;display:inline-block;max-width:92%;text-align:left;margin:0"><%= m.content %></div></div><% }) %>
        </div>
        <% if (aiEngine) { %><form method="post" action="<%= mbBase %>/onboarding/message" class="row" style="gap:8px;margin-top:8px"><%- include('partials/csrf') %>
          <input name="message" required maxlength="2000" placeholder="<%= O.missing.length ? `e.g. ${onboardingFields[O.missing[0]]}…` : 'Anything to add or change?' %>" style="flex:1;min-width:200px">
          <button class="btn" type="submit" data-onboarding-send>Send</button></form>
        <% } else { %><p class="muted" data-onboarding-form-fallback>The AI conversation switches on when the server has an AI key. Meanwhile fill in the <a href="<%= mbBase %>?tab=settings#profile">business profile</a>; Skyfly uses it the same way.</p><% } %>
      </div>
    </div>
    <% if (builds.length || activity.length) { %><div class="card" data-activity><h2>Media buyer activity</h2>
      <% if (builds.length) { %><ul><% builds.slice(0, 5).forEach((b) => { %><li><a href="<%= mbBase %>/items/<%= b.ad_item_id %>"><%= b.title %></a> · build <span class="pill <%= ['built', 'launched'].includes(b.status) ? 'delivered' : b.status.includes('fail') ? 'cancelled' : 'pending' %>"><%= b.status %></span><%= b.error ? ` · ${b.error.slice(0, 120)}` : '' %></li><% }) %></ul><% } %>
      <ul class="muted" style="font-size:13px"><% activity.forEach((x) => { %><li><%= formatDate(x.created_at) %> · <%= x.action.replace('media_buyer.', '').replace(/_/g, ' ') %></li><% }) %></ul></div><% } %>
  <% } %>

  <% if (tab === 'overview' || tab === 'campaigns') { %>
    <% if (!connection) { %>
      <div class="card"><p style="margin:0">No Meta ad account connected yet. <a href="<%= mbBase %>?tab=settings">Connect this business's own ad account</a> to see live numbers.</p></div>
    <% } else if (connection.status !== 'verified') { %>
      <div class="warn-box">The Meta connection stopped working: <%= connection.last_error %>. <a href="<%= mbBase %>?tab=settings">Reconnect</a>.</div>
    <% } else if (perf?.error) { %>
      <div class="warn-box" data-meta-error>Meta did not return data: <%= perf.error %></div>
    <% } else if (perf) { const t = perf.totals; %>
      <div class="row" style="gap:6px;margin-bottom:10px;flex-wrap:wrap"><% Object.entries(PERIODS).forEach(([k, l]) => { %><a class="btn <%= k === period ? '' : 'secondary' %>" href="<%= mbBase %>?tab=<%= tab %>&period=<%= k %>"><%= l %></a><% }) %></div>
      <div class="grid" data-kpis>
        <div class="stat"><div class="n"><%= money(t.spend) %></div><div class="l">Spend · <%= PERIODS[period] %></div></div>
        <div class="stat"><div class="n"><%= num(t.results, 0) %></div><div class="l">Results (purchases <%= num(t.purchases, 0) %>)</div></div>
        <div class="stat"><div class="n"><%= t.cpa == null ? '—' : money(t.cpa) %></div><div class="l">Cost per result</div></div>
        <div class="stat"><div class="n"><%= t.roas == null ? 'n/a' : num(t.roas) + '×' %></div><div class="l">ROAS<%= t.roas == null ? ' (no purchase value tracked)' : '' %></div></div>
        <div class="stat"><div class="n"><%= num(t.ctr) %>%</div><div class="l">CTR · CPC <%= money(t.cpc) %> · CPM <%= money(t.cpm) %></div></div>
      </div>
      <% const active = perf.campaigns.filter((c) => c.status === 'ACTIVE'); const spending = perf.campaigns.filter((c) => c.stats); const worst = spending.filter((c) => c.stats.spend > 0 && !c.stats.results); const bestAd = [...perf.ads].filter((a) => a.results).sort((a, b) => a.cpa - b.cpa)[0]; %>
      <% if (tab === 'overview') { %>
        <div class="card"><p style="margin:0">Account <strong><%= perf.account.name %></strong> (act_<%= perf.account.id %>): <strong><%= active.length %></strong> active campaign(s) of <%= perf.campaigns.length %>.
          <% if (worst.length) { %><br>Spending with no results: <%= worst.map((c) => c.name).join(', ') %>.<% } %>
          <% if (bestAd) { %><br>Best ad by cost per result: <strong><%= bestAd.name %></strong> (<%= money(bestAd.cpa) %>).<% } %></p></div>
      <% } else { %>
        <% [['Campaigns', perf.campaigns.map((c) => ({ ...(c.stats || {}), name: c.name, status: c.status, budget: c.daily_budget }))], ['Ad sets', perf.adsets], ['Ads', perf.ads]].forEach(([label, rows]) => { %>
        <div class="card"><h2><%= label %></h2><% if (!rows.length) { %><p class="muted">None in this period.</p><% } else { %>
          <div class="table-wrap"><table data-level="<%= label %>"><thead><tr><th>Name</th><% if (label === 'Campaigns') { %><th>Status (Meta)</th><th>Daily budget</th><% } %><th>Spend</th><th>Results</th><th>Cost/result</th><th>ROAS</th><th>CTR</th><th>CPC</th><th>CPM</th><th>Freq.</th></tr></thead><tbody>
          <% rows.forEach((r) => { %><tr><td><%= r.name %></td><% if (label === 'Campaigns') { %><td><%= r.status %></td><td><%= r.budget == null ? '—' : money(r.budget) %></td><% } %><td><%= money(r.spend) %></td><td><%= num(r.results, 0) %></td><td><%= r.cpa == null ? '—' : money(r.cpa) %></td><td><%= r.roas == null ? '—' : num(r.roas) %></td><td><%= num(r.ctr) %>%</td><td><%= money(r.cpc) %></td><td><%= money(r.cpm) %></td><td><%= num(r.frequency) %></td></tr><% }) %>
          </tbody></table></div><% } %></div>
        <% }) %>
      <% } %>
    <% } %>
  <% } %>

  <% if (tab === 'overview') { %>
    <div class="card" data-chat>
      <h2>Ask Cloudy</h2>
      <div style="max-height:420px;overflow:auto">
        <% messages.forEach((m) => { %><div style="margin:8px 0;<%= m.role === 'user' ? 'text-align:right' : '' %>"><div class="<%= m.role === 'user' ? 'pill' : '' %>" style="white-space:pre-wrap;display:inline-block;max-width:92%;text-align:left"><%= m.content %></div></div><% }) %>
        <% if (answer && !messages.length) { %><div style="white-space:pre-wrap"><%= answer %></div><% } %>
      </div>
      <form method="post" action="<%= mbBase %>/ask" class="row" style="gap:8px;margin-top:10px"><%- include('partials/csrf') %>
        <input name="question" required maxlength="2000" placeholder="How are my ads performing today? What is wasting my budget?" style="flex:1;min-width:220px" <%= aiOn ? '' : 'disabled' %>>
        <button class="btn" type="submit" <%= aiOn ? '' : 'disabled' %>>Ask</button>
      </form>
      <p class="muted" style="font-size:13px">Try: What should we test next? · Why is my CPA increasing? · What creative do we need next? · Should we increase the budget?</p>
    </div>
    <% if (alerts.length) { %><div class="warn-box" data-alerts-count><a href="<%= mbBase %>?tab=analysis"><%= alerts.length %> monitoring alert(s)</a> waiting in Performance Analysis.</div><% } %>
    <div class="card"><h2>Quick actions</h2><div class="row" style="gap:8px;flex-wrap:wrap"><% if (engineOn.chatgpt || engineOn.claude) { %><%- analyzeLink() %><% } %><a class="btn secondary" href="<%= mbBase %>?tab=whatsapp" data-whatsapp-link>WhatsApp Conversion Audit</a><%- genBtn('audit', 'Run account audit', false) %><%- genBtn('recommendations', 'Get recommendations') %><%- genBtn('briefs', 'New creative briefs') %><%- genBtn('campaign_draft', 'Draft a campaign') %><%- genBtn('report_daily', 'Daily report') %></div>
      <% if (pending.length) { %><p style="margin-bottom:0"><a href="<%= mbBase %>?tab=approvals"><%= pending.length %> item(s) waiting for your approval</a></p><% } %></div>
    <div class="card"><h2>Recent AI work</h2><% if (!items.length) { %><p class="muted">Nothing yet.</p><% } else { %><ul><% items.slice(0, 8).forEach((i) => { %><li><a href="<%= mbBase %>/items/<%= i.id %>"><%= i.title %></a> · <span class="pill <%= statusPill(i.status) %>"><%= i.status %></span> · <%= formatDate(i.created_at) %></li><% }) %></ul><% } %></div>
  <% } %>

  <% if (tab === 'analysis') { const A = analysis; const mon = A.monitor || {}; const PL = { today: 'Today (so far)', yesterday: 'Yesterday', last_7d: 'Last 7 days', last_14d: 'Last 14 days', last_30d: 'Last 30 days' }; %>
    <div class="card" data-analysis-form><h2>Analyze my campaigns</h2>
      <p class="muted">ChatGPT analyses the selected ad account's real Meta numbers (fetched fresh from Meta each time) and recommends what to keep, change or test, with the figures behind each point. It never changes anything in Meta: actions that would change a campaign go to Approvals.</p>
      <% if (!connection) { %><p>No Meta ad account connected yet. <a href="<%= mbBase %>?tab=settings">Connect one</a> first.</p>
      <% } else { %>
      <form method="post" action="<%= mbBase %>/analysis"><%- include('partials/csrf') %>
        <div class="grid">
          <div><label for="an-account">Ad account</label><select id="an-account" name="account"><% accounts.forEach((a) => { %><option value="<%= a.ad_account_id %>" <%= a.selected ? 'selected' : '' %>><%= a.ad_account_name || 'Ad account' %> · act_<%= a.ad_account_id %></option><% }) %></select></div>
          <div><label for="an-period">Date range</label><select id="an-period" name="period"><% A.periods.forEach((p) => { %><option value="<%= p %>" <%= p === 'last_7d' ? 'selected' : '' %>><%= PL[p] %></option><% }) %><option value="custom">Custom (dates below)</option></select></div>
          <div><label for="an-since">From (custom)</label><input id="an-since" name="since" type="date"></div>
          <div><label for="an-until">To (custom)</label><input id="an-until" name="until" type="date"></div>
          <div><label for="an-campaign">Campaign</label><select id="an-campaign" name="campaign"><option value="">All campaigns</option><% A.campaigns.forEach((c) => { %><option value="<%= c.id %>"><%= c.name %> (<%= c.status %>)</option><% }) %></select></div>
          <div><label for="an-product">Product focus (optional)</label><select id="an-product" name="product"><option value="">None</option><% A.products.forEach((p) => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div>
        </div>
        <div class="row" style="gap:8px;flex-wrap:wrap;margin-top:10px">
          <button class="btn" type="submit" name="engine" value="chatgpt" data-analyze <%= engineOn.chatgpt ? '' : 'disabled title="ChatGPT is not switched on yet (OPENAI_API_KEY)"' %>>Analyze with ChatGPT</button>
          <button class="btn secondary" type="submit" name="engine" value="claude" data-analyze-claude <%= engineOn.claude ? '' : 'disabled title="Claude is not switched on yet (ANTHROPIC_API_KEY)"' %>>Analyze with Claude</button>
          <button class="btn secondary" type="submit" name="engine" value="compare" data-compare <%= engineOn.chatgpt && engineOn.claude ? '' : 'disabled title="Needs both ChatGPT and Claude"' %>>Compare ChatGPT and Claude</button>
        </div>
        <p class="muted" style="font-size:13px">Compare sends the same data to both and shows their answers separately, then Skyfly's consolidated recommendations: where they agree, where they disagree, and what only one suggests.</p>
        <p class="muted" style="font-size:13px;margin-bottom:0">Meta does not attribute purchases to individual products; product focus adds Skyfly's own orders for that product as context.</p>
      </form><% } %>
    </div>

    <div class="card" data-alerts><h2>Monitoring alerts</h2>
      <% if (!alerts.length) { %><p class="muted">No open alerts.<%= mon.enabled ? '' : ' Monitoring is off (settings below).' %></p><% } else { %>
      <ul><% alerts.forEach((al) => { %><li data-alert="<%= al.kind %>"><span class="pill <%= al.severity === 'opportunity' ? 'delivered' : al.severity === 'high' ? 'cancelled' : 'pending' %>"><%= al.severity %></span> <%= al.message %><% if (al.suggestion) { %><br><span class="muted"><%= al.suggestion %></span><% } %><br><span class="muted">act_<%= al.ad_account_id %> · <%= formatDate(al.created_at) %></span>
        <form method="post" action="<%= mbBase %>/alerts/<%= al.id %>/dismiss" style="display:inline"><%- include('partials/csrf') %><button class="btn secondary" type="submit">Dismiss</button></form></li><% }) %></ul><% } %>
    </div>

    <div class="card" data-analyses><h2>Analyses</h2>
      <% if (!A.runs.length) { %><p class="muted">No analyses yet.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>Run</th><th>Engine</th><th>Ad account</th><th>Dates</th><th>Data fetched</th><th>Result</th></tr></thead><tbody>
      <% A.runs.forEach((r) => { %><tr><td><a href="<%= mbBase %>/analysis/<%= r.id %>">#<%= r.id %></a> · <%= formatDate(r.created_at) %></td><td><%= { chatgpt: 'ChatGPT', claude: 'Claude', compare: 'Comparison' }[r.engine] %></td><td>act_<%= r.ad_account_id %></td><td><%= r.scope.since %> → <%= r.scope.until %><%= r.scope.campaign_id ? ` · campaign ${r.scope.campaign_id}` : '' %></td><td><%= r.data_fetched_at ? formatDate(r.data_fetched_at) : '—' %></td>
        <td><% if (r.status === 'ok') { %><span class="pill delivered">ready</span><% } else { %><span class="pill cancelled">failed</span> <span class="muted"><%= r.error %></span><% } %></td></tr><% }) %>
      </tbody></table></div><% } %>
    </div>

    <div class="card" data-usage><h2>AI usage (last 30 days, this business)</h2>
      <% if (!A.usage.length) { %><p class="muted">No AI analyses yet.</p><% } else { %><table><thead><tr><th>Engine</th><th>Calls</th><th>Input tokens</th><th>Output tokens</th></tr></thead><tbody>
      <% A.usage.forEach((u) => { %><tr><td><%= u.engine === 'claude' ? 'Claude' : 'ChatGPT' %></td><td><%= u.calls %></td><td><%= Number(u.input_tokens).toLocaleString('en-NG') %></td><td><%= Number(u.output_tokens).toLocaleString('en-NG') %></td></tr><% }) %></tbody></table><% } %>
      <p class="muted" style="font-size:13px;margin-bottom:0">Limits: one analysis per minute per business and a daily cap (a comparison counts as two).</p></div>

    <div class="card" data-monitoring><h2>Automatic monitoring</h2>
      <p class="muted">Skyfly checks the selected ad account's last 7 days on a schedule and raises alerts. It never pauses, edits or spends; it only tells you. (Rule-based: no AI cost.)</p>
      <form method="post" action="<%= mbBase %>/monitoring"><%- include('partials/csrf') %>
        <label><input type="checkbox" name="enabled" <%= mon.enabled ? 'checked' : '' %>> Monitor this business's selected ad account</label>
        <div class="grid">
          <div><label for="mon-cpa">Alert when cost per purchase is above (<%= cur %>)</label><input id="mon-cpa" name="cpa_threshold" inputmode="decimal" value="<%= mon.cpa_threshold_minor ? Number(mon.cpa_threshold_minor) / 100 : '' %>"></div>
          <div><label for="mon-noconv">Alert when a campaign spends this with no conversions (<%= cur %>)</label><input id="mon-noconv" name="no_conversion_spend" inputmode="decimal" placeholder="default: 2 × average CPA" value="<%= mon.no_conversion_spend_minor ? Number(mon.no_conversion_spend_minor) / 100 : '' %>"></div>
          <div><label for="mon-ctr">Alert when link CTR drops by (%)</label><input id="mon-ctr" name="ctr_drop_pct" inputmode="numeric" value="<%= mon.ctr_drop_pct ?? 30 %>"></div>
          <div><label for="mon-freq">Alert when frequency reaches</label><input id="mon-freq" name="frequency_max" inputmode="decimal" value="<%= mon.frequency_max ?? 3.5 %>"></div>
          <div><label for="mon-int">Check every</label><select id="mon-int" name="interval_hours"><% [6, 12, 24].forEach((h) => { %><option value="<%= h %>" <%= (mon.interval_hours ?? 24) === h ? 'selected' : '' %>><%= h %> hours</option><% }) %></select></div>
        </div>
        <button class="btn" type="submit" style="margin-top:10px">Save monitoring</button>
        <% if (mon.last_run_at) { %><p class="muted" style="font-size:13px;margin-bottom:0">Last check <%= formatDate(mon.last_run_at) %><%= mon.last_error ? ` · ${mon.last_error}` : '' %></p><% } %>
      </form>
    </div>
  <% } %>

  <% if (tab === 'whatsapp') { const W = whatsapp; const L = W.leads; %>
    <div class="card" data-whatsapp-audit><h2>WhatsApp Conversion Audit</h2>
      <p class="muted">Follows your WhatsApp ads from impression to paying customer: Meta's messaging numbers for 7, 14 and 30 days, your Skyfly orders, and (if imported) your WhatsApp lead log. Skyfly computes the funnel and its checks itself; ChatGPT investigates and writes the test plan and sales scripts (Claude can give a second opinion). Nothing is changed in Meta.</p>
      <% if (!connection) { %><p>No Meta ad account connected yet. <a href="<%= mbBase %>?tab=settings">Connect one</a> first.</p><% } else { %>
      <form method="post" action="<%= mbBase %>/whatsapp" class="row" style="gap:8px;flex-wrap:wrap;align-items:flex-end"><%- include('partials/csrf') %>
        <label style="margin:0">Ad account<select name="account"><% accounts.forEach((a) => { %><option value="<%= a.ad_account_id %>" <%= a.selected ? 'selected' : '' %>><%= a.ad_account_name || 'Ad account' %> · act_<%= a.ad_account_id %></option><% }) %></select></label>
        <button class="btn" type="submit" name="engine" value="chatgpt" data-wa-run <%= engineOn.chatgpt ? '' : 'disabled title="ChatGPT is not switched on yet (OPENAI_API_KEY)"' %>>Run WhatsApp audit (ChatGPT)</button>
        <button class="btn secondary" type="submit" name="engine" value="claude" data-wa-run-claude <%= engineOn.claude ? '' : 'disabled title="Claude is not switched on yet (ANTHROPIC_API_KEY)"' %>>Second opinion (Claude)</button>
      </form><% } %>
    </div>
    <div class="card" data-wa-leads><h2>WhatsApp lead log</h2>
      <% if (L.available) { %><p data-wa-leads-count><strong><%= L.leads %></strong> leads in the last 30 days · median first reply <%= L.response.median_minutes ?? '—' %> min · <%= L.response.unanswered %> never answered · <%= L.reached.ordered %> ordered.</p>
      <% } else { %><p class="muted" data-wa-leads-missing>No lead log yet. Without it, Skyfly can measure Meta's side (conversations and how many messages customers send) but not response time, follow-ups, price presentation or closing.</p><% } %>
      <form method="post" action="<%= mbBase %>/whatsapp/leads" enctype="multipart/form-data"><%- include('partials/csrf') %>
        <label for="wa-file">Import a CSV (up to 2 MB, 5,000 leads)</label><input id="wa-file" type="file" name="file" accept=".csv,text/csv" required>
        <button class="btn secondary" type="submit" style="margin-top:8px">Import lead log</button>
      </form>
      <p class="muted" style="font-size:13px">Columns: <code>lead_id</code> (or <code>phone</code>: hashed, never stored), <code>first_message_at</code>, <code>first_response_at</code>, <code>stage</code> (messaged, responded, engaged, price_sent, order_intent, ordered, paid, delivered, repeat or lost), optional <code>furthest_stage</code> (for lost leads), <code>agent</code>, <code>follow_ups</code>, <code>lost_reason</code>, <code>campaign</code>, <code>order_value</code>. Names and message text are ignored and never stored; do not put customer details in lost_reason.</p>
    </div>
    <div class="card"><h2>Past audits</h2><% if (!W.runs.length) { %><p class="muted">None yet.</p><% } else { %><ul><% W.runs.forEach((r) => { %><li><a href="<%= mbBase %>/analysis/<%= r.id %>">Audit #<%= r.id %></a> · <%= r.engine === 'claude' ? 'Claude' : 'ChatGPT' %> · act_<%= r.ad_account_id %> · <%= formatDate(r.created_at) %> · <%= r.status === 'ok' ? 'ready' : `failed: ${r.error}` %></li><% }) %></ul><% } %></div>
  <% } %>

  <% if (tab === 'creatives') { %>
    <div class="card"><h2>Add to the creative library</h2>
      <form method="post" action="<%= mbBase %>/creatives" enctype="multipart/form-data" data-upload-creative><%- include('partials/csrf') %>
        <label for="file">File (images, logos and documents up to 8 MB; videos up to 40 MB)</label><input id="file" type="file" name="file" required accept="image/*,video/mp4,video/quicktime,video/webm,application/pdf,text/plain">
        <label for="kind">Type</label><select id="kind" name="kind"><option value="image">Product image</option><option value="video">Advertising video</option><option value="logo">Logo</option><option value="document">Product description / marketing material</option><option value="reference">Creative reference</option></select>
        <label for="notes">Notes (optional)</label><input id="notes" name="notes" maxlength="1000" placeholder="e.g. winning UGC video from March">
        <button class="btn" type="submit" style="margin-top:10px">Upload</button>
      </form></div>
    <div class="card"><h2>Library</h2><% if (!creatives.length) { %><p class="muted">No creatives yet.</p><% } else { %>
      <div class="table-wrap"><table data-creatives><thead><tr><th>File</th><th>Type</th><th>Size</th><th>Cloudy's review</th><th></th></tr></thead><tbody>
      <% creatives.forEach((c) => { %><tr><td><a href="<%= mbBase %>/creatives/<%= c.id %>/file" target="_blank" rel="noopener"><%= c.name %></a><% if (/^video\//.test(c.mime || '')) { %><br><video data-creative-video controls playsinline preload="metadata" style="max-width:260px;max-height:200px;margin-top:6px;border-radius:8px;background:#000" src="<%= mbBase %>/creatives/<%= c.id %>/file"></video><% if (c.mime === 'video/quicktime') { %><br><span class="muted" style="font-size:12px">.MOV files do not play in every browser (e.g. Chrome on Android); export as MP4 for ads and previews.</span><% } %><% } %><% if (c.notes) { %><br><span class="muted"><%= c.notes %></span><% } %></td><td><%= c.kind %></td><td><%= (Number(c.size_bytes) / 1048576).toFixed(1) %> MB</td>
        <td style="white-space:pre-wrap;max-width:420px"><%= c.ai_review || '—' %></td>
        <td><form method="post" action="<%= mbBase %>/creatives/<%= c.id %>/review"><%- include('partials/csrf') %><button class="btn secondary" type="submit" <%= aiOn ? '' : 'disabled' %>>Review with Cloudy</button></form>
            <form method="post" action="<%= mbBase %>/creatives/<%= c.id %>/delete"><%- include('partials/csrf') %><button class="btn secondary" type="submit">Delete</button></form></td></tr><% }) %>
      </tbody></table></div><% } %></div>
  <% } %>

  <% [['recommendations', 'recommendation', 'AI Recommendations', 'recommendations', 'Get new recommendations'], ['briefs', 'brief', 'Video & image briefs', 'briefs', 'Write new creative briefs'], ['reports', null, 'Reports & audits', null, null]].forEach(([t, kind, title, task, label]) => { if (tab !== t) return; const list = kind ? byKind(kind) : items.filter((i) => ['report', 'audit'].includes(i.kind)); %>
    <div class="card"><div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:8px"><h2 style="margin:0"><%= title %></h2><div class="row" style="gap:8px"><% if ((engineOn.chatgpt || engineOn.claude) && t !== 'briefs') { %><%- analyzeLink() %><% } %><% if (task) { %><%- genBtn(task, label, false) %><% } else { %><%- genBtn('report_daily', 'Daily report', false) %><%- genBtn('report_weekly', 'Weekly report') %><%- genBtn('audit', 'Full audit') %><% } %></div></div>
      <% if (!list.length) { %><p class="muted">Nothing yet.</p><% } else { %><ul><% list.forEach((i) => { %><li><a href="<%= mbBase %>/items/<%= i.id %>"><%= i.title %></a> · <span class="pill <%= statusPill(i.status) %>"><%= i.status %></span> · <%= formatDate(i.created_at) %> · <span class="muted"><%= i.data_basis %></span></li><% }) %></ul><% } %>
      <% if (t === 'briefs') { %><p class="muted" style="font-size:13px;margin-bottom:0">Videos are produced outside Skyfly from these briefs; upload the finished video to the Creative Library and ask Cloudy to review it.</p><% } %>
    </div>
  <% }) %>

  <% if (tab === 'approvals') { const by = (f) => items.filter(f); const row = (i) => `<li><a href="${mbBase}/items/${i.id}">${i.title.replace(/[<>&"]/g, '')}</a> · ${i.kind.replace('_', ' ')} · act_${i.ad_account_id || '—'}${i.meta_result?.id ? ` · Meta campaign ${i.meta_result.id} (${i.meta_result.effective_status})` : ''}${i.meta_result?.error ? ` · ${String(i.meta_result.error).replace(/[<>&"]/g, '').slice(0, 140)}` : ''}</li>`; %>
    <div class="card" data-action-center><div class="row" style="justify-content:space-between;flex-wrap:wrap;gap:8px"><h2 style="margin:0">Action center</h2><%- genBtn('campaign_draft', 'Draft a campaign', false) %></div>
      <p class="muted">Every change to Meta waits here for your approval of the exact change. Campaign drafts are created <strong>PAUSED</strong> (no ad set, ad or budget). Prepared actions (pause, daily budget) are applied only after you approve them, then read back from Meta to verify. Recommendations record your decision.</p>
      <% [['Awaiting approval', (i) => i.status === 'proposed', 'data-pending'], ['Approved (decision recorded)', (i) => i.status === 'approved', 'data-approved'], ['Executed in Meta', (i) => i.status === 'executed', 'data-executed-list'], ['Failed / not applied', (i) => i.status === 'failed', 'data-failed-list'], ['Rejected', (i) => i.status === 'rejected', 'data-rejected-list']].forEach(([title, f, attr]) => { const list = by(f).filter((i) => ['campaign_draft', 'action', 'recommendation'].includes(i.kind)); %>
        <h3><%= title %> (<%= list.length %>)</h3><% if (!list.length) { %><p class="muted">None.</p><% } else { %><ul <%= attr %>><%- list.map(row).join('') %></ul><% } %>
      <% }) %>
    </div>
    <div class="card" data-builds><h2>Campaigns built by Skyfly</h2><% if (!builds.length) { %><p class="muted">None yet. Approve a campaign plan to build it in Meta (PAUSED).</p><% } else { %><ul><% builds.forEach((b) => { %><li><a href="<%= mbBase %>/items/<%= b.ad_item_id %>"><%= b.title %></a> · <span class="pill <%= ['built', 'launched'].includes(b.status) ? 'delivered' : b.status.includes('fail') ? 'cancelled' : 'pending' %>"><%= b.status %></span> · <%= cur %> <%= (Number(b.daily_budget_minor) / 100).toLocaleString('en-NG') %>/day<%= b.error ? ` · ${b.error.slice(0, 140)}` : '' %></li><% }) %></ul><% } %></div>
    <div class="card" data-action-log><h2>Action log</h2><% if (!actionLog.length) { %><p class="muted">No change has been applied to Meta by Skyfly.</p><% } else { %>
      <div class="table-wrap"><table><thead><tr><th>When</th><th>Action</th><th>Object</th><th>Before</th><th>Requested</th><th>After (Meta)</th><th>Outcome</th></tr></thead><tbody>
      <% actionLog.forEach((l) => { %><tr><td><%= formatDate(l.created_at) %></td><td><%= l.operation %></td><td><%= l.object_level %> <%= l.object_id %> · act_<%= l.ad_account_id %></td><td><%= JSON.stringify(l.before_state) %></td><td><%= JSON.stringify(l.requested) %></td><td><%= JSON.stringify(l.after_state) %></td><td><%= l.outcome %><%= l.error ? `: ${l.error}` : '' %></td></tr><% }) %>
      </tbody></table></div><% } %></div>
  <% } %>

  <% if (tab === 'settings') { const p = profile; %>
    <div class="card"><h2>Meta ad accounts (this business's own)</h2>
      <% if (!accounts.length) { %><p class="muted">No ad account connected yet.</p><% } else { %>
      <div class="table-wrap"><table data-accounts><thead><tr><th>Ad account</th><th>Status</th><th>Facebook Page</th><th>Pixel / dataset</th><th>Token</th><th></th></tr></thead><tbody>
      <% accounts.forEach((a) => { %><tr data-account="<%= a.ad_account_id %>">
        <td><strong><%= a.ad_account_name || '—' %></strong><br><span class="muted">act_<%= a.ad_account_id %> · <%= a.currency || '—' %></span><% if (a.selected) { %><br><span class="pill delivered" data-selected>Selected</span><% } %></td>
        <% const expired = a.token_expires_at && new Date(a.token_expires_at) <= new Date(); const needsReconnect = a.status !== 'verified' || expired; %>
        <td><span class="pill <%= needsReconnect ? 'cancelled' : 'delivered' %>" data-account-status="<%= needsReconnect ? 'reconnect' : 'connected' %>"><%= needsReconnect ? 'Needs reconnection' : 'Connected · Verified with Meta' %></span>
          <% if (needsReconnect && isOwner) { %><form method="post" action="<%= mbBase %>/connect/facebook" style="margin-top:6px"><%- include('partials/csrf') %><button class="btn secondary" type="submit" data-reconnect <%= metaLogin.ready ? '' : 'disabled' %>>Reconnect with Facebook</button></form><% } %><% if (a.last_error) { %><br><span class="muted"><%= a.last_error %></span><% } %></td>
        <td><%= a.page_name ? `${a.page_name} (${a.page_id})` : 'none found' %></td>
        <td><%= a.pixel_id ? `${a.pixel_name || ''} (${a.pixel_id})` : 'none found' %></td>
        <td>encrypted, ending <%= a.token_hint %><br><span class="muted" style="font-size:12px" data-connected-via><%= a.connected_via === 'facebook_login' ? 'Facebook Login' : 'System User token' %><% if (a.token_expires_at) { const days = Math.ceil((new Date(a.token_expires_at) - Date.now()) / 864e5); %> · <%= days > 0 ? `expires in ${days} day${days === 1 ? '' : 's'}` : 'expired: connect with Facebook again' %><% } %></span>
          <% const H = a.health; if (H) { %><br><span class="muted" style="font-size:12px" data-health>Checked <%= formatDate(a.health_checked_at) %><% if (H.account) { %> · account <%= H.account.status %><% } %><% if (H.permissions) { %> · ads_management <%= H.permissions.ads_management || 'not granted' %><% } %><% if (H.capabilities) { %> · drafts <%= H.capabilities.build_drafts ? 'yes' : 'no' %>, launch <%= H.capabilities.launch ? 'yes' : 'no' %>, tracking <%= H.capabilities.conversion_tracking ? 'yes' : 'no' %>, Instagram <%= H.capabilities.instagram ? 'yes' : 'no' %><% } %></span>
          <% (H.problems || []).forEach((pr) => { %><br><span class="pill cancelled" style="font-size:12px" data-health-problem><%= pr %></span><% }) %><% if (H.error) { %><br><span class="pill cancelled"><%= H.error %></span><% } %><% } %>
          <form method="post" action="<%= mbBase %>/accounts/<%= a.ad_account_id %>/health"><%- include('partials/csrf') %><button class="btn secondary" type="submit" data-recheck>Check with Meta</button></form></td>
        <td><% if (!a.selected) { %><form method="post" action="<%= mbBase %>/accounts/<%= a.ad_account_id %>/select"><%- include('partials/csrf') %><input type="hidden" name="tab" value="settings"><button class="btn secondary" type="submit">Use this account</button></form><% } %>
            <% if (isOwner) { %><details data-disconnect><summary>Disconnect…</summary><p class="muted" style="font-size:13px;margin:6px 0">Removes act_<%= a.ad_account_id %> from this business and deletes its token. Nothing changes in Meta.</p><form method="post" action="<%= mbBase %>/accounts/<%= a.ad_account_id %>/disconnect"><%- include('partials/csrf') %><button class="btn secondary" type="submit">Yes, disconnect</button></form></details><% } %></td></tr><% }) %>
      </tbody></table></div><% } %>
      <% const ML = metaLogin, G = ML.grant; %>
      <% if (lastConnectFailure) { const D = lastConnectFailure.details || {}; %><div class="warn-box" data-last-connect-failure>Last connection attempt (<%= formatDate(lastConnectFailure.created_at) %>) failed: <%= D.error || (D.errors || []).join(' · ') || 'no detail recorded' %>. <%= /\(#?200\)|permission|code 200/i.test(JSON.stringify(D)) ? 'The token used does not have access to that ad account: the person or System User behind it must be added to the ad account in Business Settings, with ads_read / ads_management.' : /code 190|Invalid OAuth|expired/i.test(JSON.stringify(D)) ? 'The token is invalid or expired: generate a new one (or use Connect with Facebook).' : '' %></div><% } %>
      <% if (typeof fbError === 'string' && fbError) { %><div class="error" data-fb-error><%= fbError %></div><% } %>
      <% if (G) { %>
        <div class="card" id="facebook-accounts" data-fb-picker style="margin-top:12px"><h3 style="margin-top:0">Choose ad accounts to connect to <%= business.name %></h3>
          <p class="muted" style="font-size:14px">Signed in with Facebook<%= G.meta_user_name ? ` as ${G.meta_user_name}` : '' %>. These are the ad accounts Meta lets that person use. Only the ones you tick are connected, and only to this business.</p>
          <% const missing = ['ads_read', 'ads_management'].filter((p) => !(G.granted || []).includes(p)); if (missing.length) { %><div class="warn-box" data-fb-missing>Not granted: <%= missing.join(', ') %>. <%= missing.includes('ads_management') ? 'Skyfly can read results but cannot create paused drafts or launch.' : '' %> Click "Connect with Facebook" again and allow them.</div><% } %>
          <% if (!(G.accounts || []).length) { %><p data-fb-none>Meta returned no ad accounts for this Facebook profile. Ask the ad account's owner to add this person to the ad account (Business Settings → Accounts → Ad accounts → Add people), then try again.</p>
          <% } else { %><form method="post" action="<%= mbBase %>/connect/facebook/accounts"><%- include('partials/csrf') %><input type="hidden" name="grant" value="<%= G.id %>">
            <p class="muted" style="font-size:13px;margin:4px 0" data-fb-count><%= G.accounts.length %> ad account<%= G.accounts.length === 1 ? '' : 's' %> found<%= (() => { const n = new Set(G.accounts.map((a) => a.business || '—')).size; return n > 1 ? ` across ${n} business portfolios / personal accounts` : ''; })() %>.</p>
            <% if (G.truncated) { %><div class="warn-box" data-fb-truncated>Meta lists more ad accounts than Skyfly can show at once; only the first <%= G.accounts.length %> are here. Ask Meta Business Settings to narrow this person's access, or connect from a System User that only has the accounts you need.</div><% } %>
            <% G.accounts.forEach((a) => { const already = accounts.some((x) => x.ad_account_id === a.id); const restricted = a.connectable === false; %>
              <label style="display:flex;gap:8px;align-items:flex-start;font-weight:normal;margin:8px 0<%= restricted ? ';opacity:.65' : '' %>" data-fb-account="<%= a.id %>" data-fb-kind="<%= restricted ? 'restricted' : already ? 'connected' : 'discovered' %>"><input type="checkbox" name="accounts" value="<%= a.id %>" style="width:auto;margin-top:3px" <%= restricted ? 'disabled' : '' %>>
                <span><strong><%= a.name || 'Unnamed account' %></strong> · act_<%= a.id %> · <%= a.currency || '' %> · <%= a.business ? `Portfolio: ${a.business}` : 'No business portfolio (personal)' %>
                  <br><span class="muted" style="font-size:13px">Status: <%= a.status_label || (a.status === 1 ? 'Active' : `Meta status ${a.status}`) %><% if (a.access) { %> · Your access: <%= a.access %><% } %></span>
                  <% if (restricted) { %> <span class="pill cancelled">Restricted: cannot be connected</span><% } else if (a.can_build === false) { %> <span class="pill pending">Read-only: Skyfly can report but not build campaigns</span><% } %>
                  <% if (already) { %> <span class="pill delivered">Connected: reconnecting refreshes its token</span><% } %></span></label>
            <% }) %>
            <button class="btn" type="submit" style="margin-top:6px" data-fb-connect>Connect selected accounts</button></form><% } %>
          <form method="post" action="<%= mbBase %>/connect/facebook/cancel" style="margin-top:8px"><%- include('partials/csrf') %><button class="btn secondary" type="submit">Cancel</button></form>
        </div>
      <% } %>
      <% if (isOwner) { %><div style="margin:14px 0" data-fb-login>
        <form method="post" action="<%= mbBase %>/connect/facebook" style="display:inline"><%- include('partials/csrf') %><button class="btn" type="submit" <%= ML.ready ? '' : 'disabled' %> data-fb-start>Connect with Facebook</button></form>
        <% if (accounts.some((a) => a.connected_via === 'facebook_login' && a.status === 'verified')) { %><form method="post" action="<%= mbBase %>/connect/facebook/refresh" style="display:inline;margin-left:6px"><%- include('partials/csrf') %><button class="btn secondary" type="submit" data-fb-refresh>Refresh account list</button></form><% } %>
        <% if (!ML.ready) { %><p class="muted" style="font-size:13px;margin:6px 0 0" data-fb-off>Facebook Login is not switched on for Skyfly yet (the server needs <%= ML.missing.join(', ') %> from Skyfly's Meta app). Meanwhile, connect with a System User token below.</p>
        <% } else { %><p class="muted" style="font-size:13px;margin:6px 0 0">Sign in with the Facebook profile that has access to the ad account, allow the advertising permissions, then pick the accounts. Skyfly never posts or spends without your approval.</p><% } %>
      </div><% } %>
      <details <%= accounts.length ? '' : 'open' %>><summary><%= accounts.length ? 'Connect another ad account with a System User token' : 'Or connect with a System User token' %></summary>
        <ol class="muted" style="font-size:14px"><li>In <strong>Meta Business Settings → Users → System users</strong>, add a system user (or use an existing one) and give it access to the ad account (and Page).</li><li>Click <strong>Generate new token</strong>, choose your app, tick <code>ads_read</code> (and <code>ads_management</code> for campaign drafts), copy the token.</li><li>Paste it below with the ad account ID (the number after <code>act_</code> in Ads Manager). Skyfly checks it with Meta before saving. Connecting an account that is already listed refreshes its token.</li></ol>
        <form method="post" action="<%= mbBase %>/connect" autocomplete="off"><%- include('partials/csrf') %>
          <label for="ad_account_id">Ad account ID</label><input id="ad_account_id" name="ad_account_id" required inputmode="numeric" placeholder="act_1234567890">
          <label for="token">Access token</label><input id="token" name="token" type="password" required autocomplete="off">
          <button class="btn" type="submit" style="margin-top:10px">Verify and connect</button>
        </form></details>
    </div>
    <div class="card" id="profile"><h2>Business advertising profile</h2><p class="muted">Short answers are fine. The onboarding conversation fills this in for you; products and landing pages come from Skyfly automatically.<% if (p.approved_daily_limit_minor) { %> Approved daily limit for Skyfly-launched campaigns: <strong data-approved-limit><%= cur %> <%= (Number(p.approved_daily_limit_minor) / 100).toLocaleString('en-NG') %></strong>.<% } %></p>
      <form method="post" action="<%= mbBase %>/profile" data-profile><%- include('partials/csrf') %>
        <% [['industry', 'Business category'], ['business_location', 'Where the business is based'], ['website', 'Website or landing page'], ['social_accounts', 'Social accounts'], ['offer', 'Products and services'], ['prices', 'Prices (if not in Products)'], ['locations', 'Target markets'], ['audience', 'Target customer'], ['customer_profile', 'Customer profile'], ['goals', 'Advertising goals'], ['platforms', 'Preferred platforms'], ['fulfilment', 'Delivery / fulfilment'], ['payment_methods', 'How customers pay'], ['constraints', 'Anything to avoid'], ['brand_description', 'Brand description'], ['brand_voice', 'Brand voice']].forEach(([k, l]) => { %>
          <label for="<%= k %>"><%= l %></label><input id="<%= k %>" name="<%= k %>" maxlength="2000" value="<%= p[k] || '' %>">
        <% }) %>
        <label for="daily_budget">Daily advertising budget (<%= cur %>)</label><input id="daily_budget" name="daily_budget" inputmode="decimal" value="<%= p.daily_budget_minor == null ? '' : Number(p.daily_budget_minor) / 100 %>">
        <button class="btn" type="submit" style="margin-top:10px">Save profile</button>
      </form>
      <p class="muted" style="font-size:13px;margin-bottom:0">Brand assets (logos, product images, videos, documents) go in the <a href="<%= mbBase %>?tab=creatives">Creative Library</a>. Approval mode: draft-first (nothing goes live without you).</p>
    </div>
  <% } %>
</main>
</body></html>

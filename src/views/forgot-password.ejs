<%- include('partials/head', { title: 'Forgot password' }) %>
<main class="narrow auth">
  <a class="auth-brand" href="/"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></a>
  <div class="card">
    <h1>Forgot your password?</h1>
    <% if (typeof canEmail !== 'undefined' && !canEmail) { %>
      <p class="warn-box" data-reset-unavailable>Password reset by email is not available yet. Contact the Skyfly team: they can give you a one-time link to choose a new password.</p>
    <% } else if (sent) { %>
      <p class="notice">If that address has a Skyfly account, a link to choose a new password is on its way. It works once, for 60 minutes. Check your spam folder too.</p>
      <p class="muted">No email? Ask the Skyfly team for a password reset link.</p>
    <% } else { %>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <p class="muted">Enter the email address you sign in with and we'll send you a link to choose a new password.</p>
      <form method="post" action="/forgot-password">
        <%- include("partials/csrf") %>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
        <button type="submit">Send reset link</button>
      </form>
    <% } %>
    <p class="muted"><a href="/login">Back to log in</a></p>
  </div>
</main>
</body></html>

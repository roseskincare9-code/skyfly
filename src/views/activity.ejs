<%- include('partials/head', { title: 'Activity' }) %>
<%- include('partials/nav') %>
<main>
  <p><a href="<%= base %>/settings">← Settings</a></p>
  <h1>Activity log</h1>
  <p class="muted">The latest 200 changes made in this business.</p>
  <div class="card"><div class="table-wrap"><table class="stack">
    <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Item</th><th>Details</th></tr></thead>
    <tbody>
    <% entries.forEach((e) => { %>
      <tr><td class="muted"><%= formatDate(e.created_at) %></td><td><%= e.user_name || 'System' %></td><td><code><%= e.action %></code></td>
        <td><%= e.entity_id || '' %></td><td class="muted" style="font-size:13px"><%= e.details ? JSON.stringify(e.details) : '' %></td></tr>
    <% }) %>
    </tbody>
  </table></div></div>
</main>
</body></html>

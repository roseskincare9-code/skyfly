<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/nav', { active: 'settings' }) %>
<main class="narrow">
  <h1>Settings</h1>
  <% if (saved) { %><div class="notice"><%= saved %></div><% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form class="card" method="post" action="<%= base %>/settings">
    <%- include('partials/csrf') %>
    <label for="name">Business name</label>
    <input id="name" name="name" value="<%= business.name %>" required maxlength="100">
    <label for="whatsapp_number">WhatsApp number for customers</label>
    <input id="whatsapp_number" name="whatsapp_number" type="tel" value="<%= business.whatsapp_number || '' %>" placeholder="09049206695">
    <p class="muted" style="font-size:13px;margin:4px 0 0">Used for the WhatsApp button on order confirmation pages. If empty, 09049206695 is used. Changes apply to every confirmation page immediately, including for past orders.</p>
    <label for="currency">Currency for prices and orders</label>
    <select id="currency" name="currency" <%= currencyLocked ? 'disabled' : '' %>>
      <% CURRENCIES.forEach((c) => { %><option value="<%= c %>" <%= business.currency === c ? 'selected' : '' %>><%= { NGN: 'Nigerian naira (₦)', GBP: 'British pound (£)', USD: 'US dollar ($)', EUR: 'Euro (€)' }[c] %></option><% }) %>
    </select>
    <p class="muted" style="font-size:13px;margin:4px 0 0"><%= currencyLocked ? 'Fixed because this business already has orders.' : 'Set this before adding products. It cannot be changed once the business has orders.' %></p>
    <label for="order_prefix">Order reference prefix</label>
    <input id="order_prefix" name="order_prefix" value="<%= business.order_prefix %>" required pattern="[A-Za-z]{2,5}" maxlength="5">
    <p class="muted" style="font-size:13px;margin:4px 0 0">New orders look like <code><%= business.order_prefix %>-7KQ3M9X</code>.</p>
    <h2 style="margin-top:18px">Delivery</h2>
    <label for="delivery_fee">Delivery fee per order (<%= business.currency %>, empty = free delivery)</label>
    <input id="delivery_fee" name="delivery_fee" inputmode="decimal" value="<%= Number(business.delivery_fee_minor) ? business.delivery_fee_minor / 100 : '' %>" placeholder="e.g. 2500">
    <label for="free_delivery_from">Free delivery for orders from (optional)</label>
    <input id="free_delivery_from" name="free_delivery_from" inputmode="decimal" value="<%= business.free_delivery_from_minor !== null && business.free_delivery_from_minor !== undefined ? business.free_delivery_from_minor / 100 : '' %>" placeholder="e.g. 50000">
    <p class="muted" style="font-size:13px;margin:4px 0 0">Shown at checkout and added to the order total by Skyfly. Customers pay on delivery.</p>
    <p><button type="submit">Save settings</button></p>
  </form>
  <form class="card" id="notifications" method="post" action="<%= base %>/settings/notifications">
    <%- include('partials/csrf') %>
    <h2 style="margin-top:0">Order notifications</h2>
    <p class="muted" style="margin-top:0">An email for every new order Skyfly saves from your pages: order number, date, customer, products, total and a link to the order (sign-in required). Only this business's orders, only to this address.</p>
    <label for="notify_email">Notification email</label>
    <input id="notify_email" name="notify_email" type="email" maxlength="200" value="<%= notify.notify_email || '' %>" placeholder="you@example.com">
    <label style="color:var(--text)"><input type="checkbox" name="notify_enabled" <%= notify.notify_enabled ? 'checked' : '' %>> Send an email for every new order</label>
    <dl class="kv" data-notify-status>
      <dt>Address</dt><dd><% if (!notify.notify_email) { %><span class="pill cancelled">Not set</span><% } else if (notify.notify_verified_at) { %><span class="pill active">Verified</span> <span class="muted">on <%= formatDate(notify.notify_verified_at) %></span><% } else { %><span class="pill pending">Not verified</span> <span class="muted">no order emails are sent until the link we email is opened<%= notify.notify_verify_sent_at ? ' (last sent ' + formatDate(notify.notify_verify_sent_at) + ')' : '' %></span><% } %></dd>
      <dt>Sending</dt><dd><%= notifySender ? 'Ready' : 'Not set up: connect an email provider under Email → Sending setup' %></dd>
      <dt>Status</dt><dd><%= notify.notify_enabled ? 'On' : 'Off' %></dd>
    </dl>
    <p style="margin-bottom:0"><button type="submit">Save</button></p>
  </form>
  <% if (notify.notify_email && !notify.notify_verified_at) { %>
    <form class="card" method="post" action="<%= base %>/settings/notifications/verify"><%- include('partials/csrf') %>
      <p style="margin-top:0">Send a one-time link to <strong><%= notify.notify_email %></strong> (works for 48 hours).</p>
      <button type="submit" <%= notifySender ? '' : 'disabled' %>>Send verification email</button></form>
  <% } %>
  <% if (notifyRecent.length) { %>
  <div class="card"><h2 style="margin-top:0">Recent order emails</h2>
    <div class="table-wrap"><table class="stack"><thead><tr><th>Order</th><th>Email</th><th>When</th></tr></thead><tbody>
    <% notifyRecent.forEach((m) => { %><tr><td><a href="<%= base %>/orders/<%= m.order_id %>"><%= m.reference %></a></td>
      <td><span class="pill <%= m.status === 'sent' ? 'delivered' : m.status === 'failed' ? 'cancelled' : 'pending' %>"><%= { sent: 'accepted by the provider', failed: 'failed', queued: 'pending', sending: 'sending', skipped: 'not sent', cancelled: 'cancelled' }[m.status] %></span> <span class="muted"><%= m.reason || '' %></span></td>
      <td class="muted"><%= formatDate(m.sent_at || m.updated_at) %></td></tr><% }) %>
    </tbody></table></div></div>
  <% } %>
  <div class="card">
    <h2>More</h2>
    <% if (can('team')) { %><p><a href="<%= base %>/team">Team</a> <span class="muted">who can open this business, and their roles</span></p><% } %>
    <p><a href="<%= base %>/pixels">Tracking &amp; Pixels</a> · <a href="<%= base %>/integrations">Integrations</a> <span class="muted">Meta, TikTok and X tracking IDs, Google Sheets, order API keys, email sending</span></p>
    <p><a href="<%= base %>/analytics">Analytics</a> <span class="muted">orders and sales over time</span></p>
    <p style="margin-bottom:0"><a href="<%= base %>/activity">Activity log</a> <span class="muted">who changed what</span></p>
  </div>
</main>
</body></html>

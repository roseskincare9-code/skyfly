<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/nav', { active: 'settings' }) %>
<main class="narrow">
  <h1>Settings</h1>
  <% if (saved) { %><div class="notice">Settings saved.</div><% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form class="card" method="post" action="<%= base %>/settings">
    <%- include('partials/csrf') %>
    <label for="name">Business name</label>
    <input id="name" name="name" value="<%= business.name %>" required maxlength="100">
    <label for="whatsapp_number">WhatsApp number for customers</label>
    <input id="whatsapp_number" name="whatsapp_number" type="tel" value="<%= business.whatsapp_number || '' %>" placeholder="09049206695">
    <p class="muted" style="font-size:13px;margin:4px 0 0">Used for the WhatsApp button on order confirmation pages. If empty, 09049206695 is used. Changes apply to every confirmation page immediately, including for past orders.</p>
    <label for="currency">Currency for prices and orders</label>
    <select id="currency" name="currency" <%= currencyLocked ? 'disabled' : '' %>>
      <% CURRENCIES.forEach((c) => { %><option value="<%= c %>" <%= business.currency === c ? 'selected' : '' %>><%= { NGN: 'Nigerian naira (₦)', GBP: 'British pound (£)', USD: 'US dollar ($)', EUR: 'Euro (€)' }[c] %></option><% }) %>
    </select>
    <p class="muted" style="font-size:13px;margin:4px 0 0"><%= currencyLocked ? 'Fixed because this business already has orders.' : 'Set this before adding products. It cannot be changed once the business has orders.' %></p>
    <label for="order_prefix">Order reference prefix</label>
    <input id="order_prefix" name="order_prefix" value="<%= business.order_prefix %>" required pattern="[A-Za-z]{2,5}" maxlength="5">
    <p class="muted" style="font-size:13px;margin:4px 0 0">New orders look like <code><%= business.order_prefix %>-7KQ3M9X</code>.</p>
    <h2 style="margin-top:18px">Delivery</h2>
    <label for="delivery_fee">Delivery fee per order (<%= business.currency %>, empty = free delivery)</label>
    <input id="delivery_fee" name="delivery_fee" inputmode="decimal" value="<%= Number(business.delivery_fee_minor) ? business.delivery_fee_minor / 100 : '' %>" placeholder="e.g. 2500">
    <label for="free_delivery_from">Free delivery for orders from (optional)</label>
    <input id="free_delivery_from" name="free_delivery_from" inputmode="decimal" value="<%= business.free_delivery_from_minor !== null && business.free_delivery_from_minor !== undefined ? business.free_delivery_from_minor / 100 : '' %>" placeholder="e.g. 50000">
    <p class="muted" style="font-size:13px;margin:4px 0 0">Shown at checkout and added to the order total by Skyfly. Customers pay on delivery.</p>
    <p><button type="submit">Save settings</button></p>
  </form>
  <div class="card">
    <h2>More</h2>
    <% if (can('team')) { %><p><a href="<%= base %>/team">Team</a> <span class="muted">who can open this business, and their roles</span></p><% } %>
    <p><a href="<%= base %>/integrations">Pixels &amp; Integrations</a> <span class="muted">pixels, Google Sheets, order API keys, email sending</span></p>
    <p><a href="<%= base %>/analytics">Analytics</a> <span class="muted">orders and sales over time</span></p>
    <p style="margin-bottom:0"><a href="<%= base %>/activity">Activity log</a> <span class="muted">who changed what</span></p>
  </div>
</main>
</body></html>

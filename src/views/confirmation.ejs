<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Order received · <%= order.reference %></title>
  <style>
    :root { --bg:#faf7fc; --card:#fff; --text:#24132b; --muted:#6f6278; --accent:#7b2d8b; --soft:#f3eaf6; --border:#ebe3ef; --wa:#1fa855; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font-family:system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height:1.55; }
    main { max-width:520px; margin:0 auto; padding:24px 16px 40px; }
    .hero { text-align:center; padding:8px 0 20px; }
    .check { width:64px; height:64px; margin:0 auto 12px; border-radius:50%; background:#e7f7ee; display:grid; place-items:center; }
    .check svg { width:34px; height:34px; stroke:#15803d; }
    h1 { font-size:1.6rem; margin:0 0 6px; }
    .sub { color:var(--muted); margin:0; }
    .ref { display:inline-block; margin-top:14px; padding:10px 16px; border-radius:12px; background:var(--soft); color:var(--accent); font-weight:700; font-size:1.25rem; letter-spacing:.06em; }
    .ref small { display:block; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); font-weight:600; }
    .card { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:16px; margin-top:14px; }
    h2 { font-size:1rem; margin:0 0 10px; }
    .line { display:flex; justify-content:space-between; gap:12px; padding:6px 0; }
    .line + .line { border-top:1px dashed var(--border); }
    .total { font-weight:700; font-size:1.1rem; border-top:1px solid var(--border) !important; padding-top:10px; margin-top:4px; }
    .muted { color:var(--muted); }
    ol { margin:0; padding-left:20px; } ol li { margin:6px 0; }
    .wa { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; margin-top:18px; padding:16px; border-radius:14px; background:var(--wa); color:#fff; font-weight:700; font-size:1.05rem; text-decoration:none; box-shadow:0 6px 18px rgba(31,168,85,.3); }
    .wa svg { width:22px; height:22px; fill:#fff; }
    .note { text-align:center; font-size:13px; color:var(--muted); margin-top:10px; }
  </style>
</head>
<body>
<main>
  <section class="hero">
    <div class="check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
    <h1>Thank you, <%= firstName %>!</h1>
    <p class="sub">Your order has been received by <%= order.business_name %>.</p>
    <div class="ref"><small>Order reference</small><span id="ref"><%= order.reference %></span></div>
  </section>

  <section class="card">
    <h2>Your order</h2>
    <% items.forEach((i) => { %>
      <div class="line"><span><%= i.product_name %> <span class="muted">× <%= i.quantity %></span></span><span><%= formatMoney(i.line_total_minor, order.currency) %></span></div>
    <% }) %>
    <div class="line total"><span>Total</span><span id="total"><%= formatMoney(order.total_minor, order.currency) %></span></div>
    <p class="muted" style="font-size:13px;margin:8px 0 0">Pay on delivery unless our team tells you otherwise.</p>
  </section>

  <section class="card">
    <h2>Delivery details</h2>
    <div class="line"><span class="muted">Name</span><span><%= order.customer_name %></span></div>
    <div class="line"><span class="muted">Phone</span><span><%= maskedPhone %></span></div>
    <% if (order.state) { %><div class="line"><span class="muted">State</span><span><%= order.state %></span></div><% } %>
    <div class="line"><span class="muted">Placed</span><span><%= formatDate(order.created_at) %></span></div>
  </section>

  <section class="card">
    <h2>What happens next</h2>
    <ol>
      <li>Our team will call or WhatsApp you shortly to confirm your order and delivery address.</li>
      <li>We arrange delivery to you once your order is confirmed.</li>
      <li>Keep your reference <strong><%= order.reference %></strong> handy when you contact us.</li>
    </ol>
  </section>

  <% if (waUrl) { %>
  <a class="wa" id="wa" href="<%= waUrl %>" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.4-.5.3-.5v-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.5 13.5 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.1-.3-.2-.6-.4zM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4a9.8 9.8 0 1 1 8.3 4.6zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.9L.1 24l6.3-1.6A11.8 11.8 0 0 0 24 12.2a11.7 11.7 0 0 0-3.6-8.6z"/></svg>
    Chat with us on WhatsApp
  </a>
  <p class="note">Optional — your order is already saved. Use WhatsApp if you have questions.</p>
  <% } %>
</main>
</body>
</html>

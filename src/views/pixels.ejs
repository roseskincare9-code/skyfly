<%- include('partials/head', { title: 'Pixels' }) %>
<%- include('partials/nav') %>
<main style="max-width:820px">
  <h1>Tracking pixels</h1>
  <p class="muted">Enter only your pixel IDs. Skyfly adds the official pixel code to pages it hosts. Pages hosted elsewhere get it through the Skyfly script tag (see the guide). You can't paste custom scripts here; that keeps your pages and data safe.</p>
  <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

  <div class="card">
    <label for="scope">Settings for</label>
    <form method="get" action="<%= base %>/pixels" class="row">
      <select id="scope" name="page" style="flex:1">
        <option value="">All pages (business default)</option>
        <% pages.forEach((p) => { %><option value="<%= p.id %>" <%= page && page.id === p.id ? 'selected' : '' %>><%= p.name %><%= p.overrides ? ' (own settings)' : '' %></option><% }) %>
      </select>
      <button class="secondary" type="submit">Show</button>
    </form>
    <% if (page) { %>
      <p class="muted" style="font-size:13px;margin-bottom:0">Settings saved here apply to <strong><%= page.name %></strong> only and replace the business default for that pixel.
      <% if (settings.meta || settings.tiktok) { %></p>
        <form method="post" action="<%= base %>/pixels/remove-override" style="margin-top:8px"><%- include('partials/csrf') %><input type="hidden" name="page" value="<%= page.id %>"><button class="secondary" type="submit">Use business defaults for this page</button></form>
      <% } else { %> This page currently uses the business defaults.</p><% } %>
    <% } %>
  </div>

  <% PROVIDERS.forEach((provider) => { const s = settings[provider] || { enabled: false, pixel_id: '', events: ['PageView', 'InitiateCheckout', 'Lead'], server_purchase: false }; %>
  <div class="card" id="<%= provider %>">
    <div class="row" style="justify-content:space-between">
      <h2 style="margin:0"><%= LABELS[provider] %></h2>
      <span class="pill <%= s.enabled ? 'active' : '' %>"><%= s.enabled ? 'On' : 'Off' %></span>
    </div>
    <% const configured = s.enabled && s.pixel_id; const serverOn = s.server_purchase && s.access_token_enc; %>
    <dl class="kv" style="margin:12px 0" data-status="<%= provider %>">
      <dt>Configured</dt><dd><%= configured ? 'Yes: pixel ' + s.pixel_id + ' is on' : (s.pixel_id ? 'Saved but switched off' : 'No') %></dd>
      <dt>Browser events</dt><dd>
        <% if (!configured) { %><span class="muted">—</span>
        <% } else if (s.browser_verified_at) { %><span class="pill active">Verified</span> <span class="muted">confirmed by you on <%= formatDate(s.browser_verified_at) %></span>
        <% } else { %><span class="pill pending">Not verified</span> <span class="muted">configured, but nobody has confirmed events arrive yet</span><% } %></dd>
      <dt>Server Purchase</dt><dd>
        <% if (!serverOn) { %><span class="muted">Off</span>
        <% } else if (s.server_verified_at) { %><span class="pill active">Verified</span> <span class="muted"><%= provider === 'meta' ? 'Meta' : 'TikTok' %> accepted an event from Skyfly on <%= formatDate(s.server_verified_at) %></span>
        <% } else { %><span class="pill pending">Not verified</span> <span class="muted">send a test Purchase below</span><% } %></dd>
    </dl>
    <% if (configured) { %>
      <form method="post" action="<%= base %>/pixels/browser-verified" style="margin-bottom:12px">
        <%- include('partials/csrf') %><input type="hidden" name="provider" value="<%= provider %>"><% if (page) { %><input type="hidden" name="page" value="<%= page.id %>"><% } %>
        <% if (s.browser_verified_at) { %>
          <input type="hidden" name="verified" value="false"><button class="secondary" type="submit">Mark browser events as not verified</button>
        <% } else { %>
          <details><summary>How to verify browser events</summary>
            <ol style="font-size:14px;padding-left:18px">
              <li>Open the platform's <strong>Test events</strong> screen (<%= provider === 'meta' ? 'Meta Events Manager → your pixel → Test events' : 'TikTok Events Manager → your pixel → Test events' %>), or install the <strong><%= provider === 'meta' ? 'Meta Pixel Helper' : 'TikTok Pixel Helper' %></strong> browser extension.</li>
              <li>Open your published page. <strong>PageView</strong> should appear <strong>once</strong>.</li>
              <li>Tap into the order form: <strong>InitiateCheckout</strong> appears once.</li>
              <li>Submit a test order: <strong><%= provider === 'meta' ? 'Lead' : 'SubmitForm' %></strong> appears once, and <strong>no Purchase</strong>. Then mark that order as a test order in Skyfly.</li>
            </ol>
          </details>
          <input type="hidden" name="verified" value="true"><button class="secondary" type="submit">I've checked: events arrive once</button>
        <% } %>
      </form>
    <% } %>
    <form method="post" action="<%= base %>/pixels">
      <%- include('partials/csrf') %>
      <input type="hidden" name="provider" value="<%= provider %>">
      <% if (page) { %><input type="hidden" name="page" value="<%= page.id %>"><% } %>
      <label><input type="checkbox" name="enabled" <%= s.enabled ? 'checked' : '' %>> Turn on</label>
      <label for="<%= provider %>-id">Pixel ID</label>
      <input id="<%= provider %>-id" name="pixel_id" value="<%= s.pixel_id || '' %>" placeholder="<%= PIXEL_ID_RULES[provider].hint.replace(/^.*e\.g\. /, '') %>" autocomplete="off">

      <label>Browser events</label>
      <% const help = { PageView: 'every visit', ViewContent: 'visit to a product page', InitiateCheckout: 'visitor starts filling in the order form', Lead: 'order saved by Skyfly' }; %>
      <% BROWSER_EVENTS.forEach((e) => { %>
        <label style="color:var(--text)"><input type="checkbox" name="events" value="<%= e %>" <%= s.events.includes(e) ? 'checked' : '' %>> <strong><%= e %></strong> <span class="muted">· <%= help[e] %></span></label>
      <% }) %>

      <h3 style="font-size:1rem;margin:16px 0 4px">Purchase (server-side)</h3>
      <p class="muted" style="font-size:13px;margin:0">Purchase is <strong>never</strong> sent when someone visits or submits the form. Skyfly sends it from the server once, when you mark an order <strong>Paid</strong>, using the <%= provider === 'meta' ? 'Conversions API' : 'Events API' %>.</p>
      <% if (!encryptionReady) { %><div class="warn-box" style="margin-top:8px">Server-side Purchase is unavailable until the server has SKYFLY_ENCRYPTION_KEY set (see docs/SETUP.md).</div><% } %>
      <label><input type="checkbox" name="server_purchase" <%= s.server_purchase ? 'checked' : '' %> <%= encryptionReady ? '' : 'disabled' %>> Send Purchase when an order is marked Paid</label>
      <label for="<%= provider %>-token">Access token <%= s.access_token_enc ? '(saved; leave blank to keep it)' : '' %></label>
      <input id="<%= provider %>-token" name="access_token" type="password" autocomplete="new-password" placeholder="<%= s.access_token_enc ? '••••••••  saved' : 'Paste from the ad platform' %>" <%= encryptionReady ? '' : 'disabled' %>>
      <% if (s.access_token_enc) { %><label style="color:var(--text)"><input type="checkbox" name="remove_token"> Remove saved token</label><% } %>
      <label for="<%= provider %>-test">Test event code (optional)</label>
      <input id="<%= provider %>-test" name="test_event_code" value="<%= s.test_event_code || '' %>" placeholder="e.g. TEST12345">
      <p><button type="submit">Save <%= provider === 'meta' ? 'Meta' : 'TikTok' %> settings</button></p>
    </form>
    <% if (s.access_token_enc && s.test_event_code) { %>
      <form method="post" action="<%= base %>/pixels/test"><%- include('partials/csrf') %><input type="hidden" name="provider" value="<%= provider %>"><% if (page) { %><input type="hidden" name="page" value="<%= page.id %>"><% } %>
        <button class="secondary" type="submit">Send test Purchase</button></form>
    <% } %>
  </div>
  <% }) %>

  <div class="card">
    <h2>Verification status</h2>
    <ul style="padding-left:18px;margin-top:0">
      <li><strong>Browser pixels:</strong> Skyfly can't see inside Meta or TikTok. Open your published page with the <em>Meta Pixel Helper</em> or <em>TikTok Pixel Helper</em> browser extension, or use "Test events" in each platform, and check that PageView appears once.</li>
      <li><strong>Server Purchase:</strong> results of real sends are listed below and on each order.</li>
    </ul>
    <% if (recent.length === 0) { %><p class="muted">No Purchase events sent yet.</p><% } else { %>
      <div class="table-wrap"><table class="stack"><thead><tr><th>Order</th><th>Platform</th><th>Result</th><th>When</th></tr></thead><tbody>
      <% recent.forEach((r) => { %><tr><td><a href="<%= base %>/orders/<%= r.order_id %>"><%= r.reference %></a></td><td><%= r.provider === 'meta' ? 'Meta' : 'TikTok' %></td>
        <td><span class="pill <%= r.status === 'sent' ? 'delivered' : 'cancelled' %>"><%= r.status %></span> <span class="muted"><%= r.last_error || '' %></span></td><td class="muted"><%= formatDate(r.sent_at || r.created_at) %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</main>
</body></html>

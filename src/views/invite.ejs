<%- include('partials/head', { title: 'Invitation' }) %>
<main class="auth">
  <div class="auth-brand"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></div>
  <div class="card">
    <h1 style="margin-top:0">Join <%= invite.business_name %></h1>
    <p class="muted">You were invited as <strong><%= { owner: 'Owner', manager: 'Manager', staff: 'Staff' }[invite.role] %></strong> (<%= invite.email %>).</p>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (user) { %>
      <form method="post" action="/invite/<%= token %>"><%- include('partials/csrf') %><button type="submit">Join as <%= user.email %></button></form>
    <% } else if (hasAccount) { %>
      <p>You already have a Skyfly account. <a href="/login">Sign in</a> and you will come back here to join.</p>
    <% } else { %>
      <form method="post" action="/invite/<%= token %>">
        <%- include('partials/csrf') %>
        <label for="name">Your name</label><input id="name" name="name" required maxlength="200">
        <label>Email</label><input value="<%= invite.email %>" disabled>
        <label for="password">Choose a password (at least 10 characters)</label><input id="password" name="password" type="password" minlength="10" required autocomplete="new-password">
        <p><button type="submit">Create account and join</button></p>
      </form>
    <% } %>
  </div>
</main>
</body></html>

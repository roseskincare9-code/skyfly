<%- include('partials/head', { title: business.name }) %>
<%- include('partials/nav', { active: 'overview' }) %>
<main>
  <div class="row" style="justify-content:space-between">
    <h1><%= business.name %></h1>
    <a class="btn" href="<%= base %>/orders/new">+ Add order</a>
  </div>

  <div class="grid">
    <div class="stat"><div class="n"><%= formatMoney(sales.paid, business.currency) %></div><div class="l">Paid revenue</div><div class="s"><%= sales.paid_count %> paid orders</div></div>
    <div class="stat"><div class="n"><%= formatMoney(sales.to_collect, business.currency) %></div><div class="l">To collect</div><div class="s">Approved orders not yet paid</div></div>
    <div class="stat"><div class="n"><%= formatMoney(sales.confirmed, business.currency) %></div><div class="l">Approved order value</div><div class="s"><%= sales.confirmedCount %> orders</div></div>
    <div class="stat"><div class="n"><%= formatMoney(sales.pipeline, business.currency) %></div><div class="l">Pending value</div><div class="s">Not yet confirmed</div></div>
  </div>

  <div class="grid">
    <a class="stat" href="<%= base %>/orders"><div class="n"><%= totalOrders %></div><div class="l">Total orders</div></a>
    <div class="stat"><div class="n"><%= today.count %></div><div class="l">Orders today</div><div class="s"><%= formatMoney(today.total, business.currency) %></div></div>
    <% ['pending','confirmed','processing','dispatched','delivered','cancelled','returned'].forEach((s) => { %>
      <a class="stat" href="<%= base %>/orders?status=<%= s %>"><div class="n"><%= counts[s].count %></div><div class="l"><%= STATUS_LABELS[s] %></div></a>
    <% }) %>
  </div>
  <p class="muted" style="font-size:13px">
    <strong>Paid revenue</strong> counts only orders marked Paid (refunds excluded: <%= formatMoney(sales.refunded, business.currency) %>).
    <strong>Approved order value</strong> = Confirmed/Approved + Processing + Dispatched + Delivered, paid or not.
    <strong>To collect</strong> = approved orders whose payment is Unpaid, Pending or Failed.
    All figures leave out orders marked as <strong>test</strong>.
  </p>

  <div class="card">
    <div class="row" style="justify-content:space-between"><h2>Recent orders</h2><a href="<%= base %>/orders">All orders →</a></div>
    <% if (recent.length === 0) { %>
      <p class="muted">No orders yet. Orders from your landing pages will appear here.</p>
    <% } else { %>
      <div class="table-wrap"><table class="stack">
        <thead><tr><th>Reference</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
        <% recent.forEach((o) => { %>
          <tr>
            <td><a href="<%= base %>/orders/<%= o.id %>"><%= o.reference %></a></td>
            <td><%= o.customer_name %><br><a class="muted" href="tel:<%= o.phone %>"><%= o.phone %></a></td>
            <td><%= formatMoney(o.total_minor, o.currency) %></td>
            <td><%- include('partials/pills', { o }) %></td>
            <td class="muted"><%= formatDate(o.created_at) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>

  <% if (byPage.length) { %>
  <div class="card">
    <h2>Orders by landing page</h2>
    <div class="table-wrap"><table class="stack">
      <thead><tr><th>Landing page</th><th>Orders</th><th>Paid revenue</th></tr></thead>
      <tbody>
      <% byPage.forEach((p) => { %>
        <tr><td><a href="<%= base %>/orders?page=<%= p.id %>"><%= p.name %></a></td><td><%= p.orders %></td><td><%= formatMoney(p.paid, business.currency) %></td></tr>
      <% }) %>
      </tbody>
    </table></div>
  </div>
  <% } %>
</main>
</body></html>

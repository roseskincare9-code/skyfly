<%- include('partials/head', { title: 'Account not active' }) %>
<%- include('partials/nav', { active: 'subscription' }) %>
<main class="narrow">
  <div class="card" style="text-align:center;padding:32px 24px">
    <span class="pill cancelled"><%= sub.reason === 'locked' ? 'Account locked' : 'Subscription expired' %></span>
    <h1 style="margin:14px 0 6px"><%= business.name %></h1>
    <p><%= sub.reason === 'locked' ? 'This account has been paused by the Skyfly team.' : `Your subscription ended on ${business.subscription_expires_on}.` %></p>
    <p class="muted" style="white-space:pre-line"><%= renewalInstructions %></p>
    <p class="muted" style="font-size:13px;margin-bottom:0">Nothing has been deleted: your orders, customers, pages and settings are kept and will be available again as soon as the account is renewed.</p>
  </div>
</main>
</body></html>

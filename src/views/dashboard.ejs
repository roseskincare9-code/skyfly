<%- include('partials/head', { title: 'Businesses' }) %>
<%- include('partials/nav') %>
<main>
  <div class="page-head"><div><h1>Your businesses</h1><p>Choose a business to manage its orders, products, landing pages and pixels.</p></div></div>
  <div class="card">
    <h2>Businesses</h2>
    <% if (businesses.length === 0) { %>
      <p class="muted">No businesses yet. <%= offerLarose ? 'Click "Set up Larose" below' : 'Create one below' %> to get its Orders, Pixels and other settings.</p>
    <% } else { %>
      <ul class="list">
        <% businesses.forEach((b) => { %>
          <li><a href="/businesses/<%= b.id %>"><%= b.name %></a> <span class="muted">/<%= b.slug %> · <%= { owner: 'Owner', manager: 'Manager', staff: 'Staff' }[b.role] %></span>
            <% if (!b.sub.open) { %><span class="pill cancelled"><%= b.sub.status === 'locked' ? 'Locked' : 'Expired' %></span><% } else if (b.subscription_status === 'trial') { %><span class="pill pending">Trial until <%= b.subscription_expires_on %></span><% } %>
            <div class="row" style="gap:12px;font-size:14px;margin-top:4px"><a href="/businesses/<%= b.id %>/orders">Orders</a><a href="/businesses/<%= b.id %>/pixels">Pixels (Meta / TikTok)</a><a href="/businesses/<%= b.id %>/landing-pages">Pages</a></div></li>
        <% }) %>
      </ul>
    <% } %>
  </div>
  <% if (offerLarose) { %>
  <form class="card" method="post" action="/setup/larose" style="border-color:var(--accent)">
    <%- include("partials/csrf") %>
    <h2>Set up Larose Natural Skincare Nigeria</h2>
    <p class="muted" style="margin-top:0">Creates the business with its 5 packages and prices, WhatsApp number 09049206695, and registers the Larose landing page (form key <code>larosenigeria</code>) so its order form can send orders here.</p>
    <button type="submit">Set up Larose</button>
  </form>
  <% } %>
  <% if (isPlatformAdmin) { %><div class="card"><h2>Platform admin</h2><p class="muted" style="margin-top:0">Client businesses, subscriptions and invitations.</p><a class="btn" href="/admin">Open platform admin</a></div><% } %>
  <% if (canCreate) { %>
  <div class="card">
    <h2>New business</h2>
    <% if (!isPlatformAdmin) { %><p class="muted" style="margin-top:0">Starts with a <%= trialDays %>-day trial.</p><% } %>
    <form method="post" action="/businesses">
      <%- include("partials/csrf") %>
      <label for="name">Business name</label>
      <input id="name" name="name" maxlength="100" required>
      <button type="submit">Create business</button>
    </form>
  </div>
  <% } else if (businesses.length === 0) { %>
  <div class="card"><p style="margin:0">Your account isn't linked to a business yet. Ask the Skyfly team (or your business owner) for an invitation link.</p></div>
  <% } %>
</main>
</body></html>

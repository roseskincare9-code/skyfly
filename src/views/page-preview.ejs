<%- include('partials/head', { title: 'Preview · ' + v.page_name }) %>
<%- include('partials/nav') %>
<main style="max-width:1400px">
  <p><a href="<%= base %>/landing-pages/<%= v.page_id %>">← <%= v.page_name %></a></p>
  <div class="row" style="justify-content:space-between">
    <h1 style="margin:0">Preview</h1>
    <div class="row"><a class="btn secondary" href="<%= url %>" target="_blank" rel="noopener">Open full screen</a><a class="btn" href="<%= base %>/landing-pages/<%= v.page_id %>/versions/<%= v.id %>/edit">Edit this version</a></div>
  </div>
  <p class="muted">Version from <%= formatDate(v.created_at) %> (<%= v.source_name %>). In previews the order form doesn't send orders and tracking pixels are off.</p>
  <div class="row" style="align-items:flex-start;gap:24px;flex-wrap:wrap">
    <figure style="margin:0"><figcaption class="muted">Phone (390 px)</figcaption>
      <iframe title="Phone preview" src="<%= url %>" style="width:390px;height:780px;border:1px solid var(--border);border-radius:16px;background:#fff"></iframe></figure>
    <figure style="margin:0;flex:1;min-width:320px"><figcaption class="muted">Desktop (1280 px, scaled)</figcaption>
      <div style="width:100%;max-width:840px;aspect-ratio:1280/900;overflow:hidden;border:1px solid var(--border);border-radius:8px;background:#fff">
        <iframe title="Desktop preview" src="<%= url %>" style="width:1280px;height:900px;border:0;transform:scale(0.65625);transform-origin:0 0"></iframe></div></figure>
  </div>
</main>
</body></html>

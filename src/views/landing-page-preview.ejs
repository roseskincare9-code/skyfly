<%- include('partials/head', { title: 'Preview ' + page.name }) %>
<%- include('partials/nav', { active: 'pages' }) %>
<main>
  <div class="row" style="justify-content:space-between">
    <p><a href="<%= base %>/landing-pages">← Landing pages</a></p>
    <a class="btn secondary" href="<%= page.url %>" target="_blank" rel="noopener">Open page ↗</a>
  </div>
  <h1><%= page.name %> <span class="muted" style="font-weight:400;font-size:1rem">mobile preview</span></h1>
  <iframe src="<%= page.url %>" title="Preview of <%= page.name %>" style="width:390px;max-width:100%;height:780px;border:1px solid var(--border);border-radius:16px;background:#fff" sandbox="allow-scripts allow-same-origin"></iframe>
  <p class="muted" style="font-size:13px">Forms are disabled inside the preview. Use "Open page" to place a test order.</p>
</main>
</body></html>

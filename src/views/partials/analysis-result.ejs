<%
  // One engine's analysis: findings and recommendations. Locals: r (grounded result), engine, a (the analysis),
  // done (items already created, by key), mbBase, keyOf(n) → the approval key, csrfToken.
  const EV = { statistical: 'Statistical evidence', observed_pattern: 'Observed pattern', probable_cause: 'Probable cause', speculation: 'Speculation' };
  const GROUPS = [['creative', 'Creative recommendations'], ['budget', 'Budget recommendations'], ['audience', 'Audience recommendations'], ['testing', 'Testing recommendations'], ['other', 'Campaign, structure, tracking, landing page & offer recommendations']];
  const groupOf = (c) => ['creative', 'budget', 'audience', 'testing'].includes(c) ? c : 'other';
  const recs = (r.recommendations || []).map((x, n) => ({ ...x, n }));
  const chips = (ms) => (ms || []).map((m) => `${m.name}: ${m.value}`).join(' · ');
  const label = engine === 'claude' ? 'Claude' : 'ChatGPT';
  const prepOp = (x) => ['campaign', 'adset'].includes(x.entity_level) && (x.action === 'pause' ? 'pause' : ['reduce_budget', 'increase_budget'].includes(x.action) ? 'budget' : null);
%>
<section data-engine-result="<%= engine %>">
  <% if (r.summary) { %><div class="card"><h2>Summary <span class="muted" style="font-size:13px">(<%= label %>)</span></h2><p style="white-space:pre-wrap" data-ai-summary><%= r.summary %></p>
    <% if (r.data_quality) { %><p class="muted" data-sufficiency>Data sufficiency: <strong><%= r.data_quality.sufficiency %></strong><%= r.data_quality.notes.length ? ` · ${r.data_quality.notes.join(' · ')}` : '' %></p><% } %></div><% } %>
  <% if (r.priority_actions?.length) { %><div class="card" data-priority><h2>Priority action list <span class="muted" style="font-size:13px">(<%= label %>)</span></h2><ol><% r.priority_actions.forEach((x) => { %><li><%= x %></li><% }) %></ol></div><% } %>
  <% [['working', 'What is working'], ['not_working', 'What is not working'], ['campaigns_needing_attention', 'Campaigns needing attention'], ['winning_ads', 'Winning ads'], ['weak_ads', 'Weak ads'], ['tracking_concerns', 'Tracking concerns']].forEach(([k, title]) => { if (!r[k]) return; %>
    <div class="card" data-section="<%= k %>"><h2><%= title %> <span class="muted" style="font-size:13px">(<%= label %>)</span></h2><% if (!r[k].length) { %><p class="muted">Nothing found.</p><% } else { %><ul>
      <% r[k].forEach((f) => { %><li><strong><%= f.entity_name %></strong> <span class="muted">(<%= f.entity_level %> <%= f.entity_id %>)</span>: <%= f.observation %><% if (f.metrics.length) { %><br><span class="muted"><%= chips(f.metrics) %></span><% } %><br><span class="pill pending"><%= EV[f.evidence] %></span><% if (!f.grounded) { %> <span class="pill cancelled" data-ungrounded>figures not matched to the Meta data: check before acting</span><% } %></li><% }) %>
    </ul><% } %></div>
  <% }) %>
  <% GROUPS.forEach(([g, title]) => { const list = recs.filter((x) => groupOf(x.category) === g); if (!list.length) return; %>
    <div class="card" data-recs="<%= g %>"><h2><%= title %> <span class="muted" style="font-size:13px">(<%= label %>)</span></h2>
      <% list.forEach((x) => { const key = keyOf(x.n); const op = prepOp(x); %><div class="card" style="margin:10px 0" data-rec="<%= key %>">
        <h3 style="margin-top:0"><%= x.priority %>. <%= x.action.replace(/_/g, ' ') %>: <%= x.entity_name %> <span class="muted" style="font-size:13px">(<%= x.entity_level %> <%= x.entity_id %>)</span></h3>
        <dl class="kv">
          <dt>Observed</dt><dd><%= x.observed %></dd>
          <dt>Supporting metrics</dt><dd><%= chips(x.supporting_metrics) || '—' %><% if (!x.grounded) { %> <span class="pill cancelled" data-ungrounded>not matched to the Meta data</span><% } %></dd>
          <dt>Why it matters</dt><dd><%= x.why_it_matters %></dd>
          <dt>Recommended action</dt><dd><strong><%= x.recommended_action %></strong></dd>
          <dt>Expected objective</dt><dd><%= x.expected_objective %></dd>
          <dt>Confidence</dt><dd><%= x.confidence %> · <%= EV[x.evidence] %></dd>
          <dt>Risks / limitations</dt><dd><%= x.risks %></dd>
          <dt>More data needed</dt><dd><%= x.needs_more_data ? 'Yes: treat as provisional' : 'No' %></dd>
        </dl>
        <% if (x.needs_approval) { %><p class="muted" style="font-size:13px" data-needs-approval>This would change your Meta campaign. Nothing happens without your approval of the exact change.</p><% } %>
        <div class="row" style="gap:8px;flex-wrap:wrap;align-items:flex-end">
          <% const rec = (done.recommendation || {})[key]; const act = (done.action || {})[key]; %>
          <% if (rec) { %><a href="<%= mbBase %>/items/<%= rec.id %>">In Approvals (<%= rec.status %>)</a><% } else { %>
          <form method="post" action="<%= mbBase %>/analysis/<%= a.id %>/recommendations/<%= x.n %>/propose"><%- include('csrf') %><input type="hidden" name="engine" value="<%= engine %>"><button class="btn secondary" type="submit" data-propose>Send to Approvals</button></form><% } %>
          <% if (op && !x.needs_more_data) { %>
            <% if (act) { %><a href="<%= mbBase %>/items/<%= act.id %>" data-prepared>Prepared Meta change (<%= act.status %>)</a><% } else { %>
            <form method="post" action="<%= mbBase %>/analysis/<%= a.id %>/recommendations/<%= x.n %>/prepare" class="row" style="gap:6px;align-items:flex-end"><%- include('csrf') %><input type="hidden" name="engine" value="<%= engine %>">
              <% if (op === 'budget') { %><label style="margin:0">New daily budget<input name="budget" inputmode="decimal" required style="max-width:140px"></label><% } %>
              <button class="btn secondary" type="submit" data-prepare>Prepare this change in Meta (review before applying)</button></form><% } %>
          <% } %>
        </div>
      </div><% }) %>
    </div>
  <% }) %>
  <% if (r.removed_unverifiable?.length) { %><p class="muted" data-removed>Removed <%= r.removed_unverifiable.length %> point(s) from <%= label %> that referred to campaigns or ads not in this account's data.</p><% } %>
</section>

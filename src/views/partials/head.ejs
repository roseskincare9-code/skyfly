<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Skyfly</title>
  <style>
    :root { --bg:#f5f6f8; --card:#fff; --text:#16181d; --muted:#5f6673; --accent:#2563eb; --accent-soft:#e8efff;
            --border:#e3e6eb; --danger:#b91c1c; --ok:#047857; --ok-soft:#e6f6ef; --warn:#a16207; --warn-soft:#fdf6e3; --wa:#1fa855; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--text); line-height:1.5; font-size:15px; }
    a { color:var(--accent); }
    header.top { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:10px 16px; background:var(--card); border-bottom:1px solid var(--border); }
    header.top a.brand { font-weight:700; color:var(--text); text-decoration:none; }
    nav.sub { display:flex; gap:4px; overflow-x:auto; padding:0 12px; background:var(--card); border-bottom:1px solid var(--border); }
    nav.sub a { padding:10px 10px; color:var(--muted); text-decoration:none; white-space:nowrap; border-bottom:2px solid transparent; }
    nav.sub a.on { color:var(--text); border-bottom-color:var(--accent); font-weight:600; }
    main { max-width:1100px; margin:20px auto; padding:0 16px; }
    main.narrow { max-width:560px; }
    h1 { font-size:1.5rem; margin:0 0 12px; } h2 { font-size:1.15rem; margin:0 0 12px; }
    .card { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:16px; margin-bottom:16px; }
    .grid { display:grid; gap:12px; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); margin-bottom:16px; }
    .stat { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:12px 14px; text-decoration:none; color:inherit; }
    .stat .n { font-size:1.6rem; font-weight:700; } .stat .l { color:var(--muted); font-size:13px; }
    .stat .s { font-size:12px; color:var(--muted); }
    label { display:block; font-size:13px; color:var(--muted); margin:10px 0 4px; }
    input, select, textarea { width:100%; padding:9px 10px; border:1px solid var(--border); border-radius:8px; font:inherit; font-size:16px; background:#fff; }
    textarea { min-height:80px; }
    input[type=checkbox] { width:auto; }
    ::placeholder { color:#9ca3af; opacity:1; }
    .btn, button { display:inline-block; padding:9px 14px; border:1px solid var(--accent); border-radius:8px; background:var(--accent); color:#fff; font:inherit; font-weight:600; cursor:pointer; text-decoration:none; }
    .btn.secondary, button.secondary { background:#fff; color:var(--text); border-color:var(--border); }
    .btn.wa { background:var(--wa); border-color:var(--wa); }
    button.link { background:none; border:0; color:var(--muted); padding:0; font-weight:400; }
    .row { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .filters { display:grid; gap:8px; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); align-items:end; }
    .filters label { margin-top:0; }
    table { width:100%; border-collapse:collapse; }
    th, td { text-align:left; padding:9px 8px; border-bottom:1px solid var(--border); vertical-align:top; }
    th { font-size:12px; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); font-weight:600; }
    .table-wrap { overflow-x:auto; }
    .pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:12px; font-weight:600; background:#eef0f3; color:#374151; white-space:nowrap; }
    .pill.pending, .pill.pay-pending, .pill.pay-unpaid { background:var(--warn-soft); color:var(--warn); }
    .pill.pay-paid { background:var(--ok-soft); color:var(--ok); }
    .pill.pay-failed, .pill.pay-refunded { background:#fdecec; color:var(--danger); }
    .pill.confirmed, .pill.processing, .pill.dispatched { background:var(--accent-soft); color:var(--accent); }
    .pill.delivered, .pill.active { background:var(--ok-soft); color:var(--ok); }
    .pill.cancelled, .pill.returned { background:#fdecec; color:var(--danger); }
    .field-error { color:var(--danger); font-size:13px; margin-top:4px; }
    .warn-box { background:var(--warn-soft); color:var(--warn); padding:10px 12px; border-radius:8px; margin-bottom:12px; }
    code.secret { display:block; padding:10px; background:#111827; color:#f9fafb; border-radius:8px; word-break:break-all; font-size:14px; }
    .error { color:var(--danger); } .muted { color:var(--muted); } .notice { background:var(--ok-soft); color:var(--ok); padding:8px 12px; border-radius:8px; margin-bottom:12px; }
    dl.kv { display:grid; grid-template-columns:140px 1fr; gap:6px 12px; margin:0; } dl.kv dt { color:var(--muted); } dl.kv dd { margin:0; word-break:break-word; }
    @media (max-width:640px) {
      dl.kv { grid-template-columns:1fr; } dl.kv dd { margin-bottom:6px; }
      table.stack thead { display:none; }
      table.stack tr { display:block; padding:10px 0; border-bottom:1px solid var(--border); }
      table.stack td { display:block; border:0; padding:2px 0; }
    }
  </style>
</head>
<body>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#FDE8EF">
  <title><%= title %> · Skyfly by ScaleForge</title>
  <link rel="preload" href="/static/fonts/dm-sans-v17-latin.woff2" as="font" type="font/woff2" crossorigin>
  <style>
    @font-face { font-family:'DM Sans'; font-style:normal; font-weight:400 700; font-display:swap; src:url(/static/fonts/dm-sans-v17-latin.woff2) format('woff2'); }
    @font-face { font-family:'Playfair Display'; font-style:normal; font-weight:600 700; font-display:swap; src:url(/static/fonts/playfair-display-v40-latin.woff2) format('woff2'); }
    :root {
      --bg:#FFF8F5; --card:#FFFFFF; --text:#2B2229; --muted:#7A6871; --border:#F2DDE5; --line:#F7E9EE;
      --rose:#C2366B; --rose-2:#D9578A; --rose-soft:#FDE8EF; --blush:#FBD5E2; --cream:#FFF4EE;
      --champagne:#E9D8B4; --gold:#9A7838; --accent:#C2366B; --accent-soft:#FDE8EF;
      --danger:#B42318; --danger-soft:#FDECEA; --ok:#0F7B53; --ok-soft:#E5F5EE; --warn:#9A5B00; --warn-soft:#FFF3DC;
      --info:#5B4BC4; --info-soft:#EEEBFD; --wa:#1fa855;
      --shadow:0 1px 2px rgba(90,30,50,.04), 0 6px 20px rgba(194,54,107,.06);
      --radius:16px; --side:264px;
    }
    * { box-sizing:border-box; }
    html { -webkit-text-size-adjust:100%; }
    html, body { overflow-x:clip; }
    body { margin:0; font-family:"DM Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color:var(--text); line-height:1.55; font-size:15px;
           background:radial-gradient(1200px 500px at 85% -10%, #FDE3EC 0%, transparent 60%), radial-gradient(900px 400px at -10% 110%, #FFF0E6 0%, transparent 60%), var(--bg); background-attachment:fixed; min-height:100vh; }
    a { color:var(--rose); text-decoration-thickness:1px; text-underline-offset:2px; }
    h1, h2, h3 { font-family:"Playfair Display", Georgia, serif; letter-spacing:-.01em; color:#2A1D25; }
    h1 { font-size:1.7rem; margin:0 0 12px; line-height:1.2; } h2 { font-size:1.2rem; margin:0 0 12px; } h3 { font-size:1.02rem; }
    .ic { flex:none; }

    /* ---------- left sidebar ---------- */
    .nav-toggle { position:absolute; opacity:0; pointer-events:none; }
    .sidebar { position:fixed; inset:0 auto 0 0; width:var(--side); z-index:40; display:flex; flex-direction:column; gap:14px; padding:20px 14px;
               background:linear-gradient(180deg, #FFFFFF 0%, #FFF6F8 55%, #FDEAF1 100%); border-right:1px solid var(--border); overflow-y:auto; transition:transform .25s ease; }
    .logo { display:flex; align-items:center; gap:10px; padding:4px 10px; font-family:"Playfair Display", Georgia, serif; font-size:1.55rem; font-weight:700; color:#2A1D25; text-decoration:none; }
    .logo-mark { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:#fff; background:linear-gradient(135deg, #E56B98, #C2366B); box-shadow:0 6px 16px rgba(194,54,107,.3); }
    .biz-switch { position:relative; }
    .biz-switch summary { list-style:none; display:flex; align-items:center; gap:10px; padding:10px 12px; border:1px solid var(--border); border-radius:14px; background:#fff; cursor:pointer; box-shadow:var(--shadow); }
    .biz-switch summary::-webkit-details-marker { display:none; }
    .biz-switch[open] summary { border-color:var(--blush); }
    .biz-name { flex:1; font-weight:600; font-size:14px; line-height:1.25; }
    .biz-avatar { display:grid; place-items:center; width:34px; height:34px; border-radius:50%; font-size:12px; font-weight:700; color:#8A2650; background:linear-gradient(135deg, #FDE1EA, #F7C9D9); border:1px solid #F4C3D3; flex:none; }
    .biz-avatar.sm { width:26px; height:26px; font-size:10px; }
    .biz-menu { margin-top:6px; padding:6px; background:#fff; border:1px solid var(--border); border-radius:12px; box-shadow:var(--shadow); }
    .biz-menu a { display:flex; align-items:center; gap:8px; padding:8px; border-radius:10px; color:var(--text); text-decoration:none; font-size:14px; }
    .biz-menu a:hover, .biz-menu a.on { background:var(--rose-soft); }
    .side-nav { display:flex; flex-direction:column; gap:2px; }
    .side-nav a { position:relative; display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:12px; color:#4A3B43; text-decoration:none; font-weight:500; font-size:14.5px; transition:background .15s, color .15s, transform .15s; }
    .side-nav a .ic { color:#A27E8D; transition:color .15s; }
    .side-nav a:hover { background:rgba(253,232,239,.75); color:var(--rose); }
    .side-nav a:hover .ic { color:var(--rose); }
    .side-nav a.on { background:linear-gradient(135deg, #D9578A, #C2366B); color:#fff; box-shadow:0 8px 18px rgba(194,54,107,.28); }
    .side-nav a.on .ic { color:#fff; }
    .side-nav a > span:not(.badge) { flex:1; }
    .badge { min-width:22px; padding:1px 7px; border-radius:999px; background:var(--rose); color:#fff; font-size:11.5px; font-weight:700; text-align:center; }
    .side-nav a.on .badge { background:#fff; color:var(--rose); }
    .side-foot { margin-top:auto; }
    .side-art { border-radius:16px; padding:12px; background:linear-gradient(135deg, #FFF0F4, #FBE3EA); border:1px solid var(--border); text-align:center; }
    .side-art p { margin:4px 0 0; font-family:"Playfair Display", Georgia, serif; color:#8A2650; font-size:14px; }

    /* ---------- top bar ---------- */
    .topbar { position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:12px; height:68px; padding:0 28px; margin-left:var(--side);
              background:rgba(255,248,245,.82); backdrop-filter:saturate(1.4) blur(10px); -webkit-backdrop-filter:saturate(1.4) blur(10px); border-bottom:1px solid var(--line); }
    .top-title { font-weight:600; flex:1; }
    .search { flex:1; max-width:520px; display:flex; align-items:center; gap:8px; padding:0 14px; height:42px; border:1px solid var(--border); border-radius:999px; background:#fff; color:var(--muted); }
    .search input { border:0; padding:0; height:40px; background:transparent; font-size:14.5px; }
    .search input:focus { outline:none; }
    .search:focus-within { border-color:#EBA5BF; box-shadow:0 0 0 4px rgba(217,87,138,.12); }
    .icon-btn { position:relative; display:grid; place-items:center; width:42px; height:42px; border-radius:50%; background:#fff; border:1px solid var(--border); color:#5E4A54; cursor:pointer; text-decoration:none; margin-left:auto; }
    .icon-btn:hover { color:var(--rose); border-color:#EBA5BF; }
    .bell .dot { position:absolute; top:-3px; right:-3px; min-width:19px; height:19px; padding:0 5px; border-radius:999px; background:var(--rose); color:#fff; font-size:10.5px; font-weight:700; display:grid; place-items:center; border:2px solid #fff; }
    .menu-btn { display:none; margin-left:0; }
    .avatar { display:grid; place-items:center; width:40px; height:40px; border-radius:50%; font-weight:700; font-size:14px; color:#fff; background:linear-gradient(135deg, #E9A0B8, #B8975A); box-shadow:0 0 0 3px #fff, 0 0 0 4px var(--blush); flex:none; }
    .logout button { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }

    /* ---------- content ---------- */
    main { max-width:1200px; margin:0 auto; padding:26px 28px 48px; }
    .sidebar ~ main { margin-left:var(--side); max-width:none; }
    .sidebar ~ main > * { max-width:1240px; }
    main.narrow { max-width:600px; } .sidebar ~ main.narrow > * { max-width:600px; }
    .page-head { display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:18px; }
    .page-head p { margin:2px 0 0; color:var(--muted); }
    .card { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:20px; margin-bottom:18px; box-shadow:var(--shadow); }
    .card h2 { display:flex; align-items:center; gap:8px; }
    .grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); margin-bottom:18px; }
    .stat { position:relative; display:block; background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:16px 18px; text-decoration:none; color:inherit; box-shadow:var(--shadow); transition:transform .15s, box-shadow .15s; overflow:hidden; }
    a.stat:hover { transform:translateY(-2px); box-shadow:0 10px 26px rgba(194,54,107,.12); }
    .stat .n { font-size:1.65rem; font-weight:700; letter-spacing:-.02em; color:#2A1D25; }
    .stat .l { color:var(--muted); font-size:13px; font-weight:500; }
    .stat .s { font-size:12.5px; color:var(--muted); margin-top:2px; }
    .stat .ico ~ .n { padding-right:44px; font-size:1.5rem; }
    td a { text-decoration:none; } td a:hover { text-decoration:underline; }
    .stat .ico { position:absolute; right:14px; top:14px; display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:var(--rose); background:var(--rose-soft); }
    .up { color:var(--ok); font-weight:600; } .down { color:var(--danger); font-weight:600; }
    label { display:block; font-size:13px; color:var(--muted); margin:12px 0 5px; font-weight:500; }
    input, select, textarea { width:100%; padding:10px 12px; border:1px solid #EBD3DC; border-radius:12px; font:inherit; font-size:16px; background:#fff; color:var(--text); transition:border-color .15s, box-shadow .15s; }
    input:focus, select:focus, textarea:focus { outline:none; border-color:#E08DAE; box-shadow:0 0 0 4px rgba(217,87,138,.12); }
    textarea { min-height:84px; }
    input[type=checkbox], input[type=radio] { width:auto; accent-color:var(--rose); }
    input[type=file] { padding:8px; background:var(--cream); }
    ::placeholder { color:#B7A3AC; opacity:1; }
    fieldset.method { border:1px solid var(--border); border-radius:12px; padding:8px 12px; margin:12px 0; }
    fieldset.method legend { font-size:14px; color:var(--muted); padding:0 4px; }
    label.choice { display:inline-flex; align-items:center; gap:6px; margin-right:18px; color:var(--text); font-weight:600; }
    label.toggle { color:var(--text); font-weight:600; margin-top:12px; }
    details.help { font-size:13px; margin-top:6px; } details.help p { margin:6px 0; }
    form:has(input[name=install_method][value=id]:checked) .m-code { display:none; }
    form:has(input[name=install_method][value=code]:checked) .m-id { display:none; }
    .btn, button { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:10px 18px; border:1px solid transparent; border-radius:12px; background:linear-gradient(135deg, #D24C80, #B8305F); color:#fff; font:inherit; font-weight:600; font-size:14.5px; cursor:pointer; text-decoration:none; box-shadow:0 6px 14px rgba(194,54,107,.22); transition:transform .12s, box-shadow .12s, filter .12s; }
    .btn:hover, button:hover { filter:brightness(1.05); box-shadow:0 8px 20px rgba(194,54,107,.28); }
    .btn:active, button:active { transform:translateY(1px); }
    .btn.secondary, button.secondary { background:#fff; color:#4A3B43; border-color:#EBD3DC; box-shadow:none; }
    .btn.secondary:hover, button.secondary:hover { border-color:#E08DAE; color:var(--rose); }
    .btn.wa { background:var(--wa); box-shadow:none; }
    button.link { background:none; border:0; color:var(--muted); padding:0; font-weight:500; box-shadow:none; }
    button.link:hover { color:var(--rose); filter:none; box-shadow:none; }
    button:disabled { opacity:.6; cursor:wait; }
    .row { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .filters { display:grid; gap:10px; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); align-items:end; }
    .filters label { margin-top:0; }
    table { width:100%; border-collapse:collapse; }
    th, td { text-align:left; padding:12px 10px; border-bottom:1px solid var(--line); vertical-align:middle; }
    th { font-size:11.5px; text-transform:uppercase; letter-spacing:.06em; color:#9A8790; font-weight:600; background:#FFF9FA; }
    tbody tr { transition:background .12s; } tbody tr:hover { background:#FFF7FA; }
    .table-wrap { overflow-x:auto; border-radius:12px; }
    .pill { display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; background:#F3EEF0; color:#5A4A52; white-space:nowrap; }
    .pill.pending, .pill.pay-pending, .pill.pay-unpaid { background:var(--warn-soft); color:var(--warn); }
    .pill.pay-paid { background:var(--ok-soft); color:var(--ok); }
    .pill.pay-failed, .pill.pay-refunded { background:var(--danger-soft); color:var(--danger); }
    .pill.confirmed, .pill.processing, .pill.dispatched { background:var(--info-soft); color:var(--info); }
    .pill.delivered, .pill.active { background:var(--ok-soft); color:var(--ok); }
    .pill.cancelled, .pill.returned { background:var(--danger-soft); color:var(--danger); }
    .field-error { color:var(--danger); font-size:13px; margin-top:4px; }
    .warn-box { background:var(--warn-soft); color:var(--warn); padding:12px 14px; border-radius:12px; margin-bottom:14px; border:1px solid #F6E0B5; }
    code { background:#FFF1F5; color:#8A2650; padding:1px 6px; border-radius:6px; font-size:.92em; }
    code.secret { display:block; padding:12px; background:#2A1D25; color:#FDF2F6; border-radius:12px; word-break:break-all; font-size:14px; }
    .error { color:var(--danger); } p.error { background:var(--danger-soft); padding:10px 14px; border-radius:12px; }
    .muted { color:var(--muted); }
    .notice { background:var(--ok-soft); color:var(--ok); padding:10px 14px; border-radius:12px; margin-bottom:14px; border:1px solid #C8EBDB; }
    dl.kv { display:grid; grid-template-columns:150px 1fr; gap:8px 14px; margin:0; } dl.kv dt { color:var(--muted); } dl.kv dd { margin:0; word-break:break-word; }
    details > summary { cursor:pointer; }
    .list { padding-left:18px; }

    /* ---------- dashboard pieces ---------- */
    .hero { position:relative; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:24px 28px; margin-bottom:18px; border-radius:22px; overflow:hidden;
            background:linear-gradient(120deg, #FFFFFF 0%, #FFF0F4 45%, #FBD9E5 100%); border:1px solid var(--border); box-shadow:var(--shadow); }
    .hero h1 { font-size:1.9rem; margin:0; }
    .hero p { margin:6px 0 0; color:#6B5560; }
    .hero .brand-badge { display:flex; align-items:center; gap:14px; }
    .hero .seal { display:grid; place-items:center; width:64px; height:64px; border-radius:50%; background:#fff; border:1px solid #F1CCD9; box-shadow:0 6px 16px rgba(194,54,107,.12); font-family:"Playfair Display", serif; font-weight:700; color:#8A2650; font-size:20px; flex:none; }
    .hero-art { position:absolute; right:-14px; bottom:-18px; width:240px; opacity:.55; pointer-events:none; }
    .hero-content { position:relative; z-index:1; }
    .periods { display:inline-flex; padding:4px; border-radius:999px; background:#fff; border:1px solid var(--border); }
    .periods a { padding:6px 12px; border-radius:999px; font-size:13px; color:var(--muted); text-decoration:none; font-weight:600; }
    .periods a.on { background:var(--rose-soft); color:var(--rose); }
    .two { display:grid; gap:18px; grid-template-columns:minmax(0, 1.7fr) minmax(0, 1fr); }
    .chart > svg { width:100%; height:auto; display:block; }
    .chart .grid-line { stroke:#F5E4EA; stroke-width:1; }
    .chart .axis { fill:#A08F97; font-size:11px; font-family:"DM Sans", sans-serif; }
    .legend { display:grid; gap:8px; }
    .legend div { display:flex; align-items:center; gap:10px; font-size:13.5px; }
    .legend i { width:10px; height:10px; border-radius:3px; display:inline-block; }
    .legend b { margin-left:auto; font-weight:600; }
    .prod { display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--line); }
    .prod:last-child { border-bottom:0; }
    .thumb { display:grid; place-items:center; width:46px; height:46px; border-radius:14px; flex:none; font-family:"Playfair Display", serif; font-weight:700; color:#8A2650;
             background:radial-gradient(circle at 30% 25%, #fff 0, #FCE3EB 45%, #F3C3D3 100%); border:1px solid #F4D0DC; }
    .thumb.alt { background:radial-gradient(circle at 30% 25%, #fff 0, #FBF0DC 45%, #EBD5A9 100%); color:#7A5A20; border-color:#EFDDB8; }
    .quick { display:grid; gap:10px; grid-template-columns:repeat(auto-fill, minmax(190px, 1fr)); }
    .quick a { display:flex; align-items:center; gap:12px; padding:14px; border-radius:14px; background:#fff; border:1px solid var(--border); color:var(--text); text-decoration:none; font-weight:600; transition:transform .15s, box-shadow .15s, border-color .15s; }
    .quick a:hover { transform:translateY(-2px); border-color:#EBA5BF; box-shadow:0 10px 22px rgba(194,54,107,.12); }
    .quick .qi { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:var(--rose); background:var(--rose-soft); }
    .empty { text-align:center; padding:34px 20px; }
    .empty svg { max-width:220px; }
    .empty h2 { justify-content:center; }
    .bar { height:8px; border-radius:999px; background:#F8E7ED; overflow:hidden; }
    .bar > i { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg, #E98AAE, #C2366B); }

    /* ---------- sign-in pages (no sidebar) ---------- */
    main.auth { max-width:440px; margin-top:7vh; }
    main.auth .card { padding:28px; border-radius:22px; box-shadow:0 20px 50px rgba(194,54,107,.12); }
    main.auth button[type=submit] { width:100%; margin-top:18px; padding:12px; }
    .auth-brand { display:flex; align-items:center; gap:12px; margin-bottom:18px; text-decoration:none; color:#2A1D25; font-family:"Playfair Display", Georgia, serif; font-size:1.8rem; font-weight:700; }
    .logo-by { display:block; font-family:"DM Sans", sans-serif; font-size:11px; font-weight:500; color:var(--muted); letter-spacing:.01em; margin-top:-2px; }
    .auth-brand small { display:block; font-family:"DM Sans", sans-serif; font-size:13px; font-weight:500; color:var(--muted); }

    /* ---------- tablets and phones: sidebar becomes a drawer ---------- */
    @media (max-width:1024px) {
      .sidebar { transform:translateX(-102%); box-shadow:0 10px 40px rgba(60,20,35,.25); }
      .nav-toggle:checked ~ .sidebar { transform:none; }
      .nav-scrim { position:fixed; inset:0; z-index:35; background:rgba(43,34,41,.35); opacity:0; pointer-events:none; transition:opacity .2s; }
      .nav-toggle:checked ~ .nav-scrim { opacity:1; pointer-events:auto; }
      .topbar { margin-left:0; padding:0 14px; gap:8px; }
      .menu-btn { display:grid; }
      .sidebar ~ main { margin-left:0; padding:18px 14px 40px; }
      .two { grid-template-columns:1fr; }
      .hero { flex-direction:column; align-items:flex-start; }
    }
    @media (max-width:640px) {
      .user-name, .logout button { font-size:13px; }
      .search { height:40px; padding:0 10px; } .search input { font-size:16px; }
      .avatar { display:none; }
      .hero { padding:20px; } .hero h1 { font-size:1.45rem; } .hero-art { width:170px; opacity:.35; }
      .hero .seal { width:52px; height:52px; font-size:17px; }
      .periods a { padding:6px 10px; white-space:nowrap; }
      dl.kv { grid-template-columns:1fr; } dl.kv dd { margin-bottom:6px; }
      .filters { grid-template-columns:1fr 1fr; }
      table.stack thead { display:none; }
      table.stack tr { display:block; padding:12px 0; border-bottom:1px solid var(--line); }
      table.stack td { display:block; border:0; padding:2px 0; }
      .grid { grid-template-columns:repeat(2, minmax(0, 1fr)); gap:10px; }
      .stat .n { font-size:1.3rem; } .stat .ico { display:none; }
    }
    @media (prefers-reduced-motion:reduce) { *, *::before, *::after { transition:none !important; } }
  </style>
</head>
<body>

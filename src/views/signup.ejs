<%- include('partials/head', { title: 'Create a business account' }) %>
<main class="narrow auth">
  <a class="auth-brand" href="/signup"><span class="logo-mark"><%- include('partials/icon', { name: 'spark', size: 22 }) %></span><span>Skyfly<small>by ScaleForge Business Hub</small></span></a>
  <div class="card" data-owner-signup>
    <h1>Create your business account</h1>
    <p class="muted" style="margin-top:0">Your own private Skyfly workspace for your business.</p>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/signup">
      <%- include("partials/csrf") %>
      <label for="name">Full name</label>
      <input id="name" name="name" autocomplete="name" required maxlength="200" value="<%= values.name || '' %>">
      <% if (askBusiness) { %>
      <label for="business_name">Business name</label>
      <input id="business_name" name="business_name" autocomplete="organization" required maxlength="100" value="<%= values.business_name || '' %>">
      <% } %>
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email || '' %>">
      <% if (askBusiness) { %>
      <label for="phone">Phone number</label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="40" placeholder="+234 803 123 4567" value="<%= values.phone || '' %>">
      <% } %>
      <label for="password">Password (at least 10 characters)</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="10" required>
      <% if (askBusiness) { %>
      <label class="check" for="accept_terms" style="display:flex;gap:8px;align-items:flex-start;margin-top:12px;font-weight:normal">
        <input id="accept_terms" name="accept_terms" type="checkbox" required <%= values.accept_terms ? 'checked' : '' %> style="width:auto;margin-top:3px">
        <span>I have read and accept the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> and the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span>
      </label>
      <% } %>
      <%# Left empty by people (hidden from view and from screen readers); automated sign-ups fill it in. %>
      <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden">
        <label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" value="">
      </div>
      <button type="submit"><%= askBusiness ? 'Create Business Account' : 'Create account' %></button>
    </form>
    <p class="muted">Already registered? <a href="/login">Sign in</a></p>
  </div>
</main>
</body></html>

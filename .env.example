# Skyfly environment variables. Copy to .env for local development.
# Never commit real values. In production, set these in Skyfly's own Render service.

NODE_ENV=development
PORT=3000

# Skyfly's own PostgreSQL database (never another project's database).
# Works with Render Postgres or Supabase Postgres (use Supabase's "Session pooler" URL).
DATABASE_URL=postgres://skyfly:skyfly@localhost:5432/skyfly_dev
# "true" for hosted databases reached over the internet (Supabase, Render external URL).
DATABASE_SSL=false

# Long random string, unique to Skyfly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public address of this Skyfly server, used in order confirmation links.
PUBLIC_BASE_URL=http://localhost:3000

# Where Skyfly-hosted landing pages are served. MUST be a different hostname from
# PUBLIC_BASE_URL so page scripts can never read the dashboard. Locally, use 127.0.0.1
# for pages and localhost for the dashboard.
PAGES_BASE_URL=http://127.0.0.1:3000

# Encrypts Meta/TikTok access tokens in the database (32 random bytes, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes saved tokens unreadable (re-enter them).
SKYFLY_ENCRYPTION_KEY=

# Optional overrides for the ad platforms' server APIs (defaults shown).
# META_GRAPH_BASE=https://graph.facebook.com/v26.0
# TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3
# TIKTOK_PURCHASE_EVENT=Purchase

# Extra websites allowed to submit orders, comma-separated, origin only (no path).
ALLOWED_ORIGINS=https://roseskincare9-code.github.io,http://127.0.0.1:8080

# Max order submissions per IP per 10 minutes.
ORDER_RATE_LIMIT=20

# Set to "true" only while creating the first owner account, then "false".
ALLOW_SIGNUP=true

{
  "name": "skyfly",
  "version": "0.1.0",
  "private": true,
  "description": "Skyfly - lightweight business management platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 'test/**/*.test.js'",
    "seed:larose": "node --env-file-if-exists=.env src/scripts/seed-larose.js",
    "test:e2e": "node --env-file-if-exists=.env.test test/e2e/landing-page.e2e.js",
    "test:e2e:hosting": "node --env-file-if-exists=.env.test test/e2e/hosting.e2e.js",
    "test:e2e:packages": "node --env-file-if-exists=.env.test test/e2e/packages.e2e.js",
    "pages:prepare": "python3 landing-pages/prepare.py",
    "test:e2e:workspaces": "node --env-file-if-exists=.env.test test/e2e/workspaces.e2e.js",
    "test:e2e:checkout": "node --env-file-if-exists=.env.test test/e2e/checkout.e2e.js",
    "test:e2e:compat": "node --env-file-if-exists=.env.test test/e2e/sandbox-compat.e2e.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "parse5": "^7.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "supertest": "^7.3.1",
    "yazl": "^3.3.1"
  }
}

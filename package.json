{
  "name": "skyfly",
  "version": "0.1.0",
  "private": true,
  "description": "Skyfly - lightweight business management platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
